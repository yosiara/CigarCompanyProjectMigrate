<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="email_template_slot_single_modified" model="mail.template">
            <field name="name">Planning: New Task (Modified)</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="subject">{{ ctx.get('mail_subject', '') }} {{ ctx.get('start_datetime' , '') }}</field>
            <field name="email_to">{{ ctx.get('work_email', '') }}</field>
            <field name="model_id" ref="model_planning_slot"/>
            <field name="auto_delete" eval="True"/>
            <field name="description">Email sent automatically when publishing a task</field>
            <field name="body_html" type="html">
                <style>
                    .planning_mail_template_button {
                        padding: 5px 10px;
                        text-decoration: none;
                        border: 1px;
                        border-radius: 3px;
                        text-align: center;
                        color: #374151;
                        background-color: #E7E9ED;
                        border: solid #E7E9ED;
                        flex: 1 1 40%;
                    }
                    .top_button {
                        color: #FFFFFF;
                        background-color: #714B67;
                        border: solid #714B67;
                        flex: 1 1 60%;
                    }
                    .button_box {
                        display: flex;
                        flex-wrap: wrap;
                        gap: 10px;
                        margin: 20px 15px 0px 15px;
                    }
                </style>
                <div>
                    <p t-if="ctx.get('employee_name')">Apreciable <t t-out="ctx['employee_name']">Anita Oliver</t>,</p>
                    <p t-else="">Hola,</p>
                    <br/>
                    <p t-if="ctx.get('open_shift_available')">Nueva tarea abierta:</p>
                    <p t-else="">Se le ha asignado la siguiente tarea:</p>
                    <table style="margin-left: 30px;">
                        <tr t-if="(ctx.get('start_datetime') and ctx.get('end_datetime'))
                                  or ctx.get('allocated_hours')
                                  or ctx.get('allocated_percentage')"
                        >
                            <th style="padding: 5px; text-align: left;">Fecha</th>
                            <td style="padding: 5px;">
                                <span t-if="ctx.get('start_datetime') and ctx.get('end_datetime')"
                                      t-out="'%s ⟶ %s' % (
                                    ctx['start_datetime'],
                                    ctx['end_datetime'],
                                )">
                                    05/31/2021, 8:00 AM ⟶ 05/31/2021, 4:00 PM
                                </span>
                                <span t-if="ctx.get('allocated_hours')" style="opacity: 0.5;">
                                    (<t t-out="ctx['allocated_hours']">4:00</t>h)
                                </span>
                                <span t-if="ctx.get('allocated_percentage') and ctx['allocated_percentage'] != '100'" style="opacity: 0.5;">
                                    (<t t-out="ctx['allocated_percentage']">50</t>%)
                                </span>
                            </td>
                        </tr>
                        <tr t-if="object.role_id">
                            <th style="padding: 5px; text-align: left;">Comisión</th>
                            <td style="padding: 5px;" t-out="object.role_id.name or ''">Comisión</td>
                        </tr>
                        <tr t-if="object.subcommissions_id">
                            <th style="padding: 5px; text-align: left;">Subcomisión</th>
                            <td style="padding: 5px;" t-out="object.subcommissions_id.name or ''">Subcomisión</td>
                        </tr>
                        <tr t-if="object.resource_id">
                            <th style="padding: 5px; text-align: left;">Responsable</th>
                            <td style="padding: 5px;" t-out="object.resource_id.name or ''">Responsable</td>
                        </tr>
                        <tr t-if="object.ejecutor_id">
                            <th style="padding: 5px; text-align: left;">Ejecuta</th>
                            <td style="padding: 5px;" t-out="object.ejecutor_id.name or ''">Ejecuta</td>
                        </tr>
                        <tr t-if="object.control_compliance_id">
                            <th style="padding: 5px; text-align: left;">Ctrl. Cumpl.</th>
                            <td style="padding: 5px;" t-out="object.control_compliance_id.name or ''">Ctrl. Cumpl.</td>
                        </tr>
                        <tr t-if="hasattr(object, 'name') and object.name">
                            <th style="padding: 5px; text-align: left;">Descripción</th>
                            <td style="padding: 5px;" t-out="object.name or ''">/</td>
                        </tr>
                    </table>
                    <div class="button_box">
                        <a t-if="ctx.get('google_url')" t-att-href="ctx['google_url']" target="_blank"
                            class="planning_mail_template_button">Agregar a Google Calendar</a>
                        <a t-if="ctx.get('opermix_planning_url')" t-att-href="ctx['opermix_planning_url']" target="_blank"
                            class="planning_mail_template_button">Ver en Opermix/Planeación</a>
                    </div>
                    <br/>
                </div>
            </field>
        </record>

    </data>
</odoo>
