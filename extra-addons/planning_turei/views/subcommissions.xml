<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="subcommissions_view_form" model="ir.ui.view">
        <field name="name">subcommissions.view.form</field>
        <field name="model">planning_turei.subcommissions</field>
        <field name="arch" type="xml">
            <list string="Subcomisiones">
                <field name="name"/>
                <field name="planning_role_id"/>
            </list>
        </field>
    </record>

    <record id="subcommissions_view_list" model="ir.ui.view">
        <field name="name">subcommissions.view.list</field>
        <field name="model">planning_turei.subcommissions</field>
        <field name="arch" type="xml">
            <list string="Subcomisiones">
                <field name="name"/>
                <field name="planning_role_id"/>
            </list>
        </field>
    </record>

    <record id="subcommissions_view_act" model="ir.actions.act_window">
        <field name="name">Subcomisiones</field>
        <field name="res_model">planning_turei.subcommissions</field>
        <field name="view_mode">list,form</field>
        <field name="path">planning-subcommissions</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No subcommissions found. Let's create one!
            </p>
        </field>
    </record>

    <record id="planning_menu_settings_subcommissions" model="ir.ui.menu">
        <field name="name">Subcomisiones</field>
        <field name="parent_id" ref="planning.planning_menu_settings"/>
        <field name="sequence">25</field>
        <field name="action" ref="planning_turei.subcommissions_view_act"/>
        <field name="groups_id" eval="[Command.set([ref('planning_turei.group_planning_super_manager')])]"/>
    </record>

</odoo>