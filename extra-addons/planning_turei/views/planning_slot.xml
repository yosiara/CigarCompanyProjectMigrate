<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="planning_view_search_base_inherit" model="ir.ui.view">
        <field name="name">planning.slot.search.base.inherit</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_search_base"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="ejecutor_id" groups="planning.group_planning_user"/>
                <field name="control_compliance_id" groups="planning.group_planning_user"/>
                <filter string="Por cumplir" name="no_cumplido" domain="[('is_done', '=', False)]" groups="planning.group_planning_user"/>
            </xpath>
            <xpath expr="//field[@name='role_id']" position="attributes">
                <attribute name="string">Comisión</attribute>
            </xpath>
            <xpath expr="//filter[@name='group_by_role']" position="attributes">
                <attribute name="string">Comisión</attribute>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_by_ejecutor" string="Ejecuta" context="{'group_by': 'ejecutor_id'}" groups="planning.group_planning_user"/>
                <filter name="group_by_controla" string="Ctrl. Cumpl." context="{'group_by': 'control_compliance_id'}" groups="planning.group_planning_user"/>
            </xpath>
        </field>
    </record>

    <record id="planning_view_form_turei" model="ir.ui.view">
        <field name="name">planning.slot.form.turei</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='start_datetime']" position="before">
                <field name="task_seq"/>
            </xpath>
            <field name="name" position="attributes">
                <attribute name="placeholder">Descripción de la Tarea</attribute>
                <attribute name="required">1</attribute>
            </field>
            <field name="resource_id" position="attributes">
                <attribute name="string">Responsable</attribute>
                <attribute name="placeholder">Por ejemplo, Anita Oliver</attribute>
                <attribute name="required">1</attribute>
            </field>
            <field name="role_id" position="attributes">
                <attribute name="string">Comisión</attribute>
                <attribute name="placeholder">Por ejemplo, Comisión de Cuadros</attribute>
                <attribute name="required">1</attribute>
            </field>
            <field name="role_id" position="after">
                <field name="subcommissions_id" domain="[('planning_role_id', '=', role_id)]"/>
                <field name="agreement_number"/>
                <field name="ejecutor_domain" invisible="1"/>
                <field name="ejecutor_id"/>
                <field name="control_compliance_id"/>
            </field>
            <field name="name" position="after">
                <group>
                    <field name="attach_file"/>
                </group>
                <group>
                    <field name="is_done"/>
                    <field name="compliance_date" readonly="1" invisible="not is_done"/>
                    <field name="show_prorogue"/>
                    <field name="prorogation_ids" invisible="not show_prorogue"/>
                </group>
                <field name="compliance_info" invisible="not is_done" placeholder="Nota del Cumplimiento"/>
                <group>
                    <field name="attach_response" invisible="not is_done"/>
                </group>
                <group>
                    <field name="show_conformity"/>
                    <field name="conformity_date" invisible="not show_conformity" groups="planning.group_planning_manager"/>
                    <field name="final_verdict" invisible="not show_conformity" groups="planning.group_planning_manager"/>
                    <field name="conformity_date" invisible="not show_conformity" groups="planning.group_planning_manager"/>
                </group>
            </field>
            <xpath expr="//sheet" position="after">
                <chatter reload_on_follower="True"/>
            </xpath>
        </field>
    </record>

