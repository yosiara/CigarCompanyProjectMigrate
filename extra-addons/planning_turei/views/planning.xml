<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="planning_view_search_base_inherit" model="ir.ui.view">
        <field name="name">planning.slot.search.base.inherit</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_search_base"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="ejecutor_id" groups="planning.group_planning_user"/>
                <field name="control_compliance_id" groups="planning.group_planning_user"/>
                <filter string="Mis tareas" name="my_task" groups="planning_turei.group_planning_super_manager" domain="[
                    ('|'), ('|'), ('|'),
                    ('resource_id.user_id', '=', uid),
                    ('ejecutor_id.user_id', '=', uid),
                    ('control_compliance_id.user_id', '=', uid),
                    ('create_uid', '=', uid),
                ]" />
                <filter string="Cumplidas" name="cumplido" domain="[('is_done', '=', True)]" groups="planning.group_planning_user"/>
                <filter string="Por cumplir" name="no_cumplido" domain="[('is_done', '=', False)]" groups="planning.group_planning_user"/>
            </xpath>
            <xpath expr="//field[@name='role_id']" position="attributes">
                <attribute name="string">Comisión</attribute>
            </xpath>
            <xpath expr="//filter[@name='group_by_role']" position="attributes">
                <attribute name="string">Comisión</attribute>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_by_ejecutor" string="Ejecuta" context="{'group_by': 'ejecutor_id'}" groups="planning.group_planning_user"/>
                <filter name="group_by_controla" string="Ctrl. Cumpl." context="{'group_by': 'control_compliance_id'}" groups="planning.group_planning_user"/>
            </xpath>
        </field>
    </record>

    <record id="planning_view_form_inherit" model="ir.ui.view">
        <field name="name">planning.slot.form.inherit</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form"/>
        <field name="arch" type="xml">
            <field name="resource_id" position="before">
                <field name="create_uid" readonly="1" invisible="not create_uid"/>
            </field>
            <field name="resource_id" position="attributes">
                <attribute name="string">Responsable</attribute>
                <attribute name="placeholder">Por ejemplo, Anita Oliver</attribute>
                <attribute name="required">1</attribute>
                <attribute name="readonly">not start_datetime or not end_datetime or (create_uid and create_uid != uid)</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_open': True}</attribute>
            </field>
            <field name="role_id" position="attributes">
                <attribute name="string">Comisión</attribute>
                <attribute name="placeholder">Por ejemplo, Comisión de Cuadros</attribute>
                <attribute name="required">1</attribute>
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </field>
            <field name="role_id" position="after">
                <field name="subcommissions_id" domain="[('planning_role_id', '=', role_id)]" readonly="create_uid and create_uid != uid"/>
                <field name="ejecutor_domain" invisible="1"/>
                <field name="ejecutor_id" readonly="create_uid and create_uid != uid"/>
                <field name="control_compliance_id" readonly="create_uid and create_uid != uid"/>
            </field>
            <field name="name" position="attributes">
                <attribute name="placeholder">Nota de la tarea...</attribute>
                <attribute name="required">1</attribute>
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </field>
            <field name="company_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <!-- ############################### slot_info_right ############################################### -->
            <xpath expr="//label[@for='start_datetime']" position="before">
                <field name="task_seq"/>
            </xpath>
            <xpath expr="//field[@name='start_datetime']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='repeat']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='repeat_interval']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='repeat_unit']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='repeat_type']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='repeat_until']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='repeat_number']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_hours']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='allocated_percentage']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//field[@name='slot_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">create_uid and create_uid != uid</attribute>
            </xpath>
            <xpath expr="//div[@class='o_row']" position="after">
                <field name="agreement_number" readonly="create_uid and create_uid != uid"/>
            </xpath>
            <!-- ############################### slot_info_down ############################################### -->
            <field name="name" position="after">
                <field name="description" type="html" options="{'collaborative': true, 'resizable': false}" placeholder="Ajuntar detalles..." readonly="create_uid and create_uid != uid"/>

                <group name="prorogue" class="d-inline-flex">
                    <field name="show_prorogue" widget="boolean_toggle"/>
                    <field name="prorogation_ids" nolabel="1" invisible="not show_prorogue" readonly="user_id != uid"/>
                </group>

                <group name="done">
                    <group class="d-inline-flex">
                        <field name="is_done" widget="boolean_toggle" readonly="ejecutor_uid != uid"/>
                        <field name="compliance_date" readonly="1" invisible="not is_done"/>
                    </group>
                    <group>
                        <field name="compliance_info" type="html" options="{'collaborative': true, 'resizable': false}" nolabel="1" invisible="not is_done" placeholder="Nota del Cumplimiento" readonly="ejecutor_uid != uid"/>
                    </group>
                </group>

                <group name="conformity">
                    <group class="d-inline-flex">
                        <field name="show_conformity" widget="boolean_toggle" readonly="control_compliance_uid != uid"/>
                        <field name="conformity_date" invisible="not show_conformity" readonly="1"/>
                    </group>
                    <group>
                        <field name="final_verdict" invisible="not show_conformity" readonly="control_compliance_uid != uid"/>
                    </group>
                </group>
                
            </field>
            <xpath expr="//button[@name='auto_plan_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter reload_on_follower="True"/>
            </xpath>
        </field>
    </record>

    <record id="planning_view_form_in_gantt_inherit" model="ir.ui.view">
        <field name="name">planning.form.in.gantt.inherit</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form_in_gantt"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_save_template']" position="attributes">
                <attribute name="groups">planning_turei.group_planning_super_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='auto_plan_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- planning.role views -->
    <record id="planning_role_view_form_inherit" model="ir.ui.view">
        <field name="name">planning.role.view.form.inherit</field>
        <field name="model">planning.role</field>
        <field name="inherit_id" ref="planning.planning_role_view_form"/>
        <field name="arch" type="xml">
            <field name="color" position="before">
                <field name="management_book" widget="boolean_toggle"/>
            </field>
        </field>
    </record>

    <record id="planning_role_view_list_inherit" model="ir.ui.view">
        <field name="name">planning.role.view.list.inherit</field>
        <field name="model">planning.role</field>
        <field name="inherit_id" ref="planning.planning_role_view_tree"/>
        <field name="arch" type="xml">
            <field name="color" position="before">
                <field name="management_book" widget="boolean_toggle"/>
            </field>
        </field>
    </record>
    
    <!-- ACTION INHERIT -->
    <record id="planning.planning_action_schedule_by_resource" model="ir.actions.act_window">
        <field name="context">{
            'planning_expand_resource': 1,
            'planning_expand_role': 1,
            'search_default_my_task': 1,
            'search_default_no_cumplido': 1,
        }</field>
    </record>

    <!-- MENUS INHERIT -->
    <record id="planning.planning_menu_settings" model="ir.ui.menu">
        <field name="groups_id" eval="[Command.set([ref('planning_turei.group_planning_super_manager')])]"/>
    </record>

        <record id="planning.planning_menu_settings_employee" model="ir.ui.menu">
            <field name="groups_id" eval="[Command.set([ref('planning_turei.group_planning_super_manager')])]"/>
        </record>

        <record id="planning.planning_menu_settings_resource" model="ir.ui.menu">
            <field name="groups_id" eval="[Command.set([ref('planning_turei.group_planning_super_manager')])]"/>
        </record>

        <record id="planning.planning_menu_settings_role" model="ir.ui.menu">
            <field name="groups_id" eval="[Command.set([ref('planning_turei.group_planning_super_manager')])]"/>
        </record>

        <record id="planning.planning_menu_settings_shift_template" model="ir.ui.menu">
            <field name="groups_id" eval="[Command.set([ref('planning_turei.group_planning_super_manager')])]"/>
        </record>

</odoo>
