<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_letter_landscape_calendar" model="report.paperformat">
            <field name="name">US Letter Landscape</field>
            <field name="default" eval="False"/>
            <field name="format">Letter</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">8</field>
            <field name="margin_bottom">6</field>
            <field name="margin_left">6</field>
            <field name="margin_right">6</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>

        <record id="action_report_individual_plan" model="ir.actions.report">
            <field name="name">Work Plan</field>
            <field name="model">report.calendar_turei.report_individual_plan</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">calendar_turei.report_individual_plan</field>
            <field name="report_file">calendar_turei.report_individual_plan</field>
            <field name="paperformat_id" ref="calendar_turei.paperformat_letter_landscape_calendar"/>
            <field name="print_report_name">'Individual Plan'</field>
            <field name="binding_type">report</field>
        </record>

        <template id="calendar_turei.report_individual_plan">
            <t t-call="web.html_container">
                <meta charset="utf-8"/>
                <style>
                    /* ============ BASE ============ */
                    .ip {
                        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                        font-size: 8pt;
                        line-height: 1.25;
                        color: #212529;
                    }

                    /* ============ HEADER ============ */
                    .ip-header {
                        width: 100%;
                        border-collapse: collapse;
                        border-bottom: 2px solid #343a40;
                        margin-bottom: 5px;
                    }
                    .ip-header td {
                        vertical-align: top;
                        padding: 2px 4px 4px 4px;
                    }
                    .ip-label {
                        font-size: 6.5pt;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        color: #6c757d;
                        margin-bottom: 1px;
                    }
                    .ip-title {
                        text-align: center;
                        font-size: 11pt;
                        font-weight: bold;
                        letter-spacing: 1px;
                        text-transform: uppercase;
                        color: #212529;
                    }
                    .ip-period {
                        text-align: center;
                        font-size: 9pt;
                        color: #495057;
                        margin-top: 1px;
                    }
                    .ip-manager-name { font-weight: 600; }
                    .ip-manager-job  { color: #6c757d; font-size: 7pt; }
                    .ip-area         { font-weight: 600; }

                    /* ============ SECTION TITLE ============ */
                    .ip-section {
                        font-size: 7.5pt;
                        font-weight: bold;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        color: #495057;
                        border-bottom: 1px solid #ced4da;
                        padding-bottom: 1px;
                        margin: 4px 0 3px 0;
                    }
                    .ip-activities {
                        font-size: 7.5pt;
                        color: #343a40;
                        margin: 0 0 5px 0;
                    }

                    /* ============ WEEK GRID ============ */
                    .ip-week {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                        margin-bottom: 3px;
                        page-break-inside: avoid;
                    }
                    .ip-week th {
                        background: #f1f3f5;
                        border: 1px solid #ced4da;
                        padding: 2px 2px 1px 2px;
                        font-size: 7.5pt;
                        font-weight: bold;
                        text-align: center;
                        color: #343a40;
                    }
                    .ip-week th .day-num {
                        display: block;
                        font-size: 7pt;
                        font-weight: normal;
                        color: #6c757d;
                    }
                    .ip-week td {
                        border: 1px solid #dee2e6;
                        vertical-align: top;
                        padding: 2px 3px;
                        font-size: 7pt;
                        height: 46px;
                        width: 14.28%;
                    }
                    .ip-week th.weekend,
                    .ip-week td.weekend { background: #fafbfc; }
                    .ip-week td.empty   { background: #f5f6f7; }

                    /* ============ TASK ============ */
                    .task {
                        display: block;
                        margin-bottom: 1px;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }
                    .task-hour {
                        color: #0d6efd;
                        font-weight: bold;
                        margin-right: 3px;
                    }

                    /* ============ SIGNATURES ============ */
                    .ip-sign {
                        width: 100%;
                        border-collapse: collapse;
                        margin-top: 20px;
                        page-break-inside: avoid;
                    }
                    .ip-sign td {
                        width: 50%;
                        text-align: center;
                        vertical-align: bottom;
                        padding: 0 24px;
                    }
                    .ip-sign .line {
                        border-top: 1px solid #495057;
                        font-size: 8pt;
                        font-weight: 600;
                        color: #212529;
                        min-height: 12px;
                    }
                    .ip-sign .role {
                        font-size: 7pt;
                        font-weight: normal;
                        color: #6c757d;
                        margin-top: 1px;
                        min-height: 12px;
                    }
                </style>

                <t t-foreach="docs" t-as="o">
                    <div class="page ip">

                        <!-- ============ HEADER ============ -->
                        <table class="ip-header">
                            <tr>
                                <td width="25%">
                                    <t t-if="not is_company">
                                        <div class="ip-label">Approved by</div>
                                        <div class="ip-manager-name"><span t-out="o['manager_name']"/></div>
                                        <div class="ip-manager-job"><span t-out="o['manager_job']"/></div>
                                    </t>
                                    <t t-else="">
                                        <div class="ip-label">Company</div>
                                        <div class="ip-manager-name"><span t-out="o['name']"/></div>
                                    </t>
                                </td>
                                <td width="50%">
                                    <div class="ip-title"><span t-out="o['report_title']"/></div>
                                    <div class="ip-period"><span t-out="o['month']"/></div>
                                </td>
                                <td width="25%" style="text-align:right;">
                                    <t t-if="not is_company">
                                        <div class="ip-label">Area</div>
                                        <div class="ip-area"><span t-out="o['area']"/></div>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- ============ MAIN ACTIVITIES ============ -->
                        <div class="ip-section">Main Activities</div>
                        <div class="ip-activities">
                            <t t-foreach="o['main_task_list']" t-as="task_name">
                                <span t-out="task_name"/>.
                            </t>
                        </div>

                        <!-- ============ CALENDAR ============ -->
                        <t t-foreach="o['calendar']" t-as="week">
                            <table class="ip-week">
                                <thead>
                                    <tr>
                                        <t t-foreach="range(7)" t-as="i">
                                            <th t-attf-class="day-header #{'weekend' if i >= 5 else ''}">
                                                <t t-out="day_names[i]"/>
                                                <span class="day-num" t-out="week[i]['day'] or ''"/>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <t t-foreach="range(7)" t-as="i">
                                            <td t-attf-class="#{'weekend' if i >= 5 else ''} #{'empty' if not week[i]['day'] else ''}">
                                                <t t-foreach="week[i]['task']" t-as="task">
                                                    <span class="task">
                                                        <span class="task-hour" t-out="task['hour_start']"/>
                                                        <span t-out="task['name']"/>
                                                    </span>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <!-- ============ SIGNATURES ============ -->
                        <table class="ip-sign">
                            <tr>
                                <td>
                                    <t t-if="not is_company">
                                        <div class="line"><span t-out="o['name']"/></div>
                                        <div class="role"><span t-out="o['job']"/></div>
                                    </t>
                                </td>
                                <td>
                                    <div class="line"><span t-out="o['manager_name']"/></div>
                                    <div class="role"><span t-out="o['manager_job']"/></div>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
