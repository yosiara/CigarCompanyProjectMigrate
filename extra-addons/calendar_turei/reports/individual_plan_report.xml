<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_letter_landscape_calendar" model="report.paperformat">
            <field name="name">US Letter Landscape</field>
            <field name="default" eval="True"/>
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">20</field>
            <field name="margin_bottom">05</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True"/>
            <field name="header_spacing">25</field>
            <field name="dpi">96</field>
        </record>

        <record id="paperformat_letter_portrait_calendar" model="report.paperformat">
            <field name="name">US Letter Portrait</field>
            <field name="default" eval="True"/>
            <field name="format">Letter</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">20</field>
            <field name="margin_bottom">05</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="True"/>
            <field name="header_spacing">25</field>
            <field name="dpi">96</field>
        </record>

        <record id="action_report_individual_plan" model="ir.actions.report">
            <field name="name">Plan de Trabajo</field>
            <field name="model">report.calendar_turei.report_individual_plan</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">calendar_turei.report_individual_plan</field>
            <field name="report_file">calendar_turei.report_individual_plan</field>
            <field name="paperformat_id" ref="calendar_turei.paperformat_letter_landscape_calendar"/>
            <field name="print_report_name">'Plan Individual'</field>
            <field name="binding_type">report</field>
            <field name="attachment">'Plan'+(object.employee_id.name)+'.pdf'</field>
            <field name="attachment_use">True</field>
        </record>

        <template id="calendar_turei.report_individual_plan">
            <t t-call="web.html_container">
                <meta http-equiv="content-type" content="text/html; charset=utf-8"/>
                <t t-tag="Plan de Trabajo ? 'button' : 'span'" class="badge border d-flex p-2 ms-2 bg-view" data-hotkey="y"/>
                <t t-foreach="docs" t-as="o">
<!--                    <t t-call="web.external_layout_standard">-->
                        <div class="page">
                            <table width="100%" cellpadding="0" cellspacing="0">
                                    <tr valign="top">
                                        <td width="15%" style="border: none; padding: 0cm">
                                            <p align="right"><font face="Arial" style="font-size: 8pt">Aprobado por: </font></p>
                                        </td>
                                        <td width="24%" style="border: none; padding: 0cm">
                                            <p align="left"><font face="Arial" style="font-size: 8pt"><span  t-esc="o['manager_name']"/></font>
                                                <br></br>
                                            <font face="Arial" style="font-size: 8pt"><span  t-esc="o['manager_job']"/></font></p>
                                        </td>
                                        <td width="30%" style="border: none; padding: 0cm">
                                            <p align="center"><font face="Arial" style="font-size: 8pt"><b>PLAN DE TRABAJO INDIVIDUAL</b>
                                            <br></br>
                                            <b><span  t-esc="o['mes']"/> </b></font></p>
                                        </td>
                                        <td width="30%" style="border: none; padding: 0cm">
                                            <p align="right"><font face="Arial" style="font-size: 8pt">Área: <span t-esc="o['area']"/></font></p>
                                        </td>
                                    </tr>
                                    <tr valign="top">
                                        <td width="15%" style="border: none; padding: 0cm">
                                            <p align="right">  </p>
                                        </td>
                                        <td width="24%" style="border: none; padding: 0cm">
                                            <p align="left"> </p>
                                        </td>
                                        <td width="30%" style="border: none; padding: 0cm">
                                            <p align="center"> </p>
                                        </td>
                                        <td width="30%" style="border: none; padding: 0cm">
                                            <p align="right"> </p>
                                        </td>
                                    </tr>
                            </table>
                            <p align="left">
                            <font face="Arial"><font style="font-size: 8pt"><span lang="es-ES"><b>ACTIVIDADES PRINCIPALES:</b></span>
                                <t t-foreach="o['main_task_list']" t-as="t">
                                                <font face="Arial" style="font-size: 8pt">
                                                    <span t-esc="t"/>.
                                                </font>
                                    </t>
                            </font> </font>
                            </p>
                            <t t-set="flag" t-value="0"/>
