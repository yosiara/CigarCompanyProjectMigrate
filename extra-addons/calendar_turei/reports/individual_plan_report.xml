                                            <p>
                                                <font face="Arial" style="font-size: 8pt">
                                                    <t t-foreach="week[5]['task']" t-as="task">
                                                        <span t-esc="task['hour_start']"/>-
                                                        <span t-esc="task['name']"/>
<!--                                                        <t t-if="task['local']">-->
<!--                                                            <span t-esc="task['local']"/>-->
<!--                                                        </t>-->
                                                        <br/>
