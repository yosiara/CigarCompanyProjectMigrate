<?xml version="1.0"?>
<odoo>

    <!-- Calendar Event : Form View -->
    <record id="view_calendar_event_form_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <field name="start_date" position="before">
                <field name="group_task"/>
                <field name="organizational_groups_ids" invisible="group_task == False" required="group_task == True" widget="many2many_tags"/>
            </field>
            <field name="name" position="after">
                <label for="short_name">Nombre Corto</label>
                <field name="short_name"/>
            </field>
            <field name="event_tz" position="before">
                <field name="task_type"/>
                <field name="priority"/>
            </field>
            <field name="location" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <xpath expr="//field[@name='partner_ids']" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="domain">[('type', '!=', 'private'), ('employee_ids', '!=', False)]</attribute>
            </xpath>
        </field>
    </record>
    
    <!-- Calendar Event : Form quick create View -->
    <record id="view_calendar_event_form_quick_create_inherit" model="ir.ui.view">
        <field name="name">calendar.event.form.quick.create.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="short_name" placeholder="Nombre Corto"/>
            </xpath>
            <xpath expr="//label[@for='videocall_location']" position="before">
                <field name="location" placeholder="Reunión en línea" required="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_ids']" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="domain">[('type', '!=', 'private'), ('employee_ids', '!=', False)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Calendar Event : Calendar View -->
    <record id="view_calendar_event_calendar_inherit" model="ir.ui.view">
        <field name="name">calendar.event.calendar.inherit</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="event_limit">11</attribute>
            </xpath>
            <field name="location" position="after">
                <field name="short_name"/>
            </field>
        </field>
    </record>

    <menuitem
        id="calendar_turei_reports_menu"
        parent="calendar.mail_menu_calendar"
        name="Reportes"
        sequence="5"
        groups="base.group_user"/>

    <!-- MENUS ADD GROUPS ACCESS -->
    <record id="calendar.calendar_menu_config" model="ir.ui.menu">
        <field name="groups_id" eval="[Command.link(ref('calendar_turei.group_calendar_turei_manager'))]"/>
    </record>
    
        <record id="calendar.calendar_submenu_reminders" model="ir.ui.menu">
            <field name="groups_id" eval="[Command.link(ref('calendar_turei.group_calendar_turei_manager'))]"/>
        </record>
    
</odoo>
