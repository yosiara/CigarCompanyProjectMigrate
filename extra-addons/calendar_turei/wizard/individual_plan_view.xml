<?xml version="1.0" encoding="utf-8"?>
<odoo>
		<record id="calendar_print_individual_plan_wzd_view_form"	model="ir.ui.view">
			<field name="name">calendar_turei.print_individual_plan</field>
			<field name="model">calendar_turei.print_individual_plan</field>
			<field name="type">form</field>
			<field name="arch" type="xml">
				<form string="Imprimir">
					 <field invisible="1" name="state"/>
					<separator string="Wizard to print employee´s plan related reports"/>
					<div>
						<label for="state" string="Using this wizard you can print Employee´s individuals plan and Accomplish resume plan." colspan="4"/>
						<p>You must select the reports... </p>
						<field name="type" widget="radio"/>
						<group col="4">
							<field name="period_id" domain="[('anual','=',False)]" options='{"no_create":true,"no_open":true}'/>
							<field name="format"  invisible="'type','in',('ics')"/>
						</group>
						<group col="4">
							<field name="date_start"/>
							<field name="date_end"/>
							<label for="text" colspan="4"  invisible="'type','in',('plan','ics')"/>
							<field name="text" colspan="4" invisible="'type','in',('plan','ics')" nolabel="1"/>
							<!-- <field name="employee_id"/> -->
						</group>
						<p invisible="'type','in',('resume','ics')">Remember all tasks must be <b>non-recurring</b> to proceed with the task evaluation.</p>
						<p invisible="'type','in',('resume','ics')">If you do not know what this means, leave the checkbox marked <field name="confirmed"/></p>
                	</div>

<!--					<div states="get">-->

<!--						 <p>Here is the exported ICS file: <field name="data" readonly="1" filename="name"/></p>-->
<!--						 <p>Copy to your mobile device and opened with ICalendar compatible application.</p>-->

<!--					</div>-->
				    <footer>
                        <div>
<!--                            <button name="print_individual_plan" states = "print" string="Print" type="object" class="oe_highlight"/> o-->
                            <button name="print_individual_plan" string="Imprimir" type="object" class="oe_highlight"/> 
                            <button special="cancel" string="Cerrar" class="oe_link"/>
                        </div>
                    </footer>
				</form>
			</field>
		</record>

    <record id="action_calendar_print_individual_plan" model="ir.actions.act_window">
		<field name="name">Imprimir Plan de Trabajo</field>
		<field name="type">ir.actions.act_window</field>
		<field name="res_model">calendar_turei.print_individual_plan</field>
		<field name="view_mode">form</field>
		<!-- <field name="binding_model_id" ref="hr.model_hr_employee"/> -->
		<field name="binding_view_types">form</field>
		<field name="target">new</field>
	</record>

	<menuitem
		id="print_individual_plan_menu"
		parent="calendar_turei.calendar_turei_reports_menu"
		name="Plan de Trabajo"
		sequence="6"
		action="action_calendar_print_individual_plan"
		groups="base.group_user"/>
        
</odoo>
