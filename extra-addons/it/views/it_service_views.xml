<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View it.service View List -->
    <record id="view_it_service_list" model="ir.ui.view">
        <field name="name">view.it.service.list</field>
        <field name="model">it.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View it.service form -->
    <record id="view_it_service_form" model="ir.ui.view">
        <field name="name">view.it.service.form</field>
        <field name="model">it.service</field>
        <field name="arch" type="xml">
            <form string="It Service">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View it.service search -->
    <record id="view_it_service_search" model="ir.ui.view">
        <field name="name">view.it.service.search</field>
        <field name="model">it.service</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action it.service -->
    <record id="action_it_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">it.service</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new It Service.
            </p>
        </field>
    </record>

    <menuitem id="menu_services" 
              name="Services" 
              parent="menu_it_root" 
              sequence="40"
              action="action_it_service"/>

</odoo>
