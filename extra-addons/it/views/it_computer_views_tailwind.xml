    <record id="view_it_computer_kanban" model="ir.ui.view">
        <field name="name">it.computer.kanban</field>
        <field name="model">it.computer</field>
        <field name="arch" type="xml">
            <kanban js_class="computer_kanban">
                <field name="name"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="type"/>
                <field name="state"/>
                <field name="employee_id"/>
                <field name="processor"/>
                <field name="ram_gb"/>
                <field name="storage_gb"/>
                
                <templates>
                    <t t-name="card">
                        <!-- Tarjeta principal con hover effects -->
                        <div class="oe_kanban_card oe_kanban_global_click 
                                    bg-white rounded-xl shadow-lg hover:shadow-2xl 
                                    transition-all duration-300 transform hover:-translate-y-1 
                                    border border-gray-100 overflow-hidden relative
                                    group">
                            
                            <!-- Barra superior degradado según estado -->
                            <div t-att-class="'h-2 w-full ' + (
                                record.state.raw_value === 'new' ? 'bg-gradient-to-r from-green-400 to-green-600' :
                                record.state.raw_value === 'in_use' ? 'bg-gradient-to-r from-blue-400 to-blue-600' :
                                record.state.raw_value === 'repair' ? 'bg-gradient-to-r from-yellow-400 to-orange-500' :
                                'bg-gradient-to-r from-gray-400 to-gray-600'
                            )"></div>
                            
                            <!-- Badge de estado flotante -->
                            <div class="absolute top-3 right-3 z-10">
                                <span t-att-class="'px-3 py-1 rounded-full text-xs font-semibold shadow-lg ' + (
                                    record.state.raw_value === 'new' ? 'bg-green-100 text-green-800 border border-green-200' :
                                    record.state.raw_value === 'in_use' ? 'bg-blue-100 text-blue-800 border border-blue-200' :
                                    record.state.raw_value === 'repair' ? 'bg-yellow-100 text-yellow-800 border border-yellow-200' :
                                    'bg-gray-100 text-gray-800 border border-gray-200'
                                )">
                                    <i t-attf-class="fa {{
                                        record.state.raw_value === 'new' ? 'fa-star' :
                                        record.state.raw_value === 'in_use' ? 'fa-play-circle' :
                                        record.state.raw_value === 'repair' ? 'fa-wrench' : 'fa-archive'
                                    }} mr-1 text-xs"/>
                                    <t t-esc="record.state.raw_value.replace('_', ' ').toUpperCase()"/>
                                </span>
                            </div>
                            
                            <!-- Contenido de la tarjeta -->
                            <div class="p-5">
                                <!-- Icono principal animado -->
                                <div class="flex justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                                    <div t-att-class="'w-16 h-16 rounded-2xl flex items-center justify-center ' + (
                                        record.type.raw_value === 'laptop' ? 'bg-blue-50 text-blue-600' :
                                        record.type.raw_value === 'desktop' ? 'bg-purple-50 text-purple-600' :
                                        'bg-indigo-50 text-indigo-600'
                                    )">
                                        <i t-attf-class="fa {{
                                            record.type.raw_value === 'laptop' ? 'fa-laptop' :
                                            record.type.raw_value === 'desktop' ? 'fa-desktop' : 'fa-server'
                                        }} text-3xl"/>
                                    </div>
                                </div>
                                
                                <!-- Nombre y modelo -->
                                <div class="text-center mb-3">
                                    <h3 class="font-bold text-lg text-gray-800 mb-1">
                                        <field name="name"/>
                                    </h3>
                                    <p class="text-sm text-gray-500">
                                        <field name="brand"/> <field name="model"/>
                                    </p>
                                </div>
                                
                                <!-- Especificaciones técnicas -->
                                <div class="flex justify-center gap-2 mb-4">
                                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-lg text-xs flex items-center">
                                        <i class="fa fa-microchip mr-1 text-gray-500"/>
                                        <t t-esc="record.processor.raw_value or 'N/A'"/>
                                    </span>
                                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-lg text-xs flex items-center">
                                        <i class="fa fa-memory mr-1 text-gray-500"/>
                                        <t t-esc="record.ram_gb.raw_value or '?'"/>GB
                                    </span>
                                    <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded-lg text-xs flex items-center">
                                        <i class="fa fa-hdd-o mr-1 text-gray-500"/>
                                        <t t-esc="record.storage_gb.raw_value or '?'"/>GB
                                    </span>
                                </div>
                                
                                <!-- Asignación -->
                                <!-- <div t-if="record.employee_id.raw_value" class="mt-3 pt-3 border-t border-gray-100">
                                    <div class="flex items-center justify-center">
                                        <div class="w-8 h-8 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 
                                                    flex items-center justify-center text-white text-sm font-bold shadow-md mr-2">
                                            <span t-esc="record.employee_id.raw_value.charAt(0).toUpperCase()"/>
                                        </div>
                                        <div class="text-left">
                                            <p class="text-xs text-gray-400">Asignado a</p>
                                            <p class="text-sm font-medium text-gray-700">
                                                <field name="employee_id"/>
                                            </p>
                                        </div>
                                    </div>
                                </div> -->
                                
                                <!-- IP si existe (campo opcional) -->
                                <div t-if="record.ip_address.raw_value" class="mt-2 text-center">
                                    <span class="text-xs bg-gray-50 text-gray-600 px-2 py-1 rounded-full">
                                        <i class="fa fa-network-wired mr-1"/>
                                        <field name="ip_address"/>
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Footer con acciones (hover) -->
                            <div class="absolute bottom-0 left-0 right-0 bg-white bg-opacity-95 
                                        transform translate-y-full group-hover:translate-y-0 
                                        transition-transform duration-300 border-t border-gray-100
                                        flex justify-around py-2">
                                <button class="text-blue-600 hover:text-blue-800 text-sm flex items-center gap-1">
                                    <i class="fa fa-eye"/> Ver
                                </button>
                                <button class="text-green-600 hover:text-green-800 text-sm flex items-center gap-1">
                                    <i class="fa fa-edit"/> Editar
                                </button>
                                <button class="text-purple-600 hover:text-purple-800 text-sm flex items-center gap-1">
                                    <i class="fa fa-cog"/> Mantenimiento
                                </button>
                            </div>
                            
                            <!-- Efecto de brillo en hover -->
                            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white to-transparent 
                                        opacity-0 group-hover:opacity-20 transform -skew-x-12 translate-x-full 
                                        group-hover:translate-x-[-200%] transition-all duration-1000 pointer-events-none">
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- View it.computer View List -->
    <record id="view_it_computer_list" model="ir.ui.view">
        <field name="name">it.computer.list</field>
        <field name="model">it.computer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="employee_id"/>
                <field name="state"/>
                <field name="purchase_date"/>
            </list>
        </field>
    </record>

    <!-- View it.computer form -->
    <record id="view_it_computer_form" model="ir.ui.view">
        <field name="name">view.it.computer.form</field>
        <field name="model">it.computer</field>
        <field name="arch" type="xml">
            <form string="It Computer">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <field name="type"/>
                    <field name="brand"/>
                    <field name="model"/>
                    <field name="employee_id"/>
                    <field name="state"/>
                    <field name="purchase_date"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View it.computer search -->
    <record id="view_it_computer_search" model="ir.ui.view">
        <field name="name">view.it.computer.search</field>
        <field name="model">it.computer</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action it.computer -->
    <record id="action_it_computer" model="ir.actions.act_window">
        <field name="name">Computers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">it.computer</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new It Computer.
            </p>
        </field>
    </record>

    <menuitem id="menu_computers" 
              name="Computers" 
              parent="menu_it_root" 
              sequence="20"
              action="action_it_computer"/>


</odoo>
