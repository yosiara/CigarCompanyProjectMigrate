<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View it.reports View List -->
    <record id="view_it_reports_list" model="ir.ui.view">
        <field name="name">view.it.reports.list</field>
        <field name="model">it.reports</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View it.reports form -->
    <record id="view_it_reports_form" model="ir.ui.view">
        <field name="name">view.it.reports.form</field>
        <field name="model">it.reports</field>
        <field name="arch" type="xml">
            <form string="It Reports">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View it.reports search -->
    <record id="view_it_reports_search" model="ir.ui.view">
        <field name="name">view.it.reports.search</field>
        <field name="model">it.reports</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action it.reports -->
    <record id="action_it_reports" model="ir.actions.act_window">
        <field name="name">It Reports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">it.reports</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new It Reports.
            </p>
        </field>
    </record>

</odoo>
