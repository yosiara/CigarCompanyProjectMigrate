<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="it.Dashboard">
        <div class="o_it_dashboard">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center my-4">
                <h2>Dashboard</h2>
                <button class="btn btn-primary" t-on-click="loadDashboardData">
                    <i class="fa fa-refresh"/> Refresh
                </button>
            </div>

            <!-- Loading Spinner -->
            <div t-if="state.loading" class="text-center my-5">
                <i class="fa fa-spinner fa-spin fa-3x"/>
                <p class="mt-2">Loading data...</p>
            </div>

            <!-- Dashboard Content -->
            <div t-else="" class="container-fluid">
                <!-- KPI Cards -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <h5 class="card-title">Employees</h5>
                                <h2 t-out="state.stats.total_employees"/>
                                <i class="fa fa-users fa-2x float-right"/>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <h5 class="card-title">Computers</h5>
                                <h2 t-out="state.stats.total_computers"/>
                                <i class="fa fa-laptop fa-2x float-right"/>
                            </div>
                        </div>
