                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <h5 class="card-title">Phones</h5>
                                <h2 t-out="state.stats.total_phones"/>
                                <i class="fa fa-mobile fa-2x float-right"/>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <div class="card bg-warning text-white">
                            <div class="card-body">
                                <h5 class="card-title">Services</h5>
                                <h2 t-out="state.stats.active_services"/>
                                <i class="fa fa-wifi fa-2x float-right"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Computers by Status -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5>Computers by Status</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="state.stats.computers_by_state.length">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Status</th>
                                                <th>Count</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.stats.computers_by_state" t-as="item" t-key="item.state">
                                                <td>
                                                    <span t-att-class="getStatusClass(item.state)">
                                                        <t t-out="item.state"/>
                                                    </span>
                                                </td>
                                                <td t-out="item.count"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">No data available</p>
                                </t>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Recent Assignments -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h5>Recent Assignments</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="state.stats.recent_assignments.length">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Employee</th>
                                                <th>Equipment</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.stats.recent_assignments" t-as="item" t-key="item.id">
                                                <td t-out="item.employee"/>
                                                <td t-out="item.equipment"/>
                                                <td t-out="item.date"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">No recent assignments</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>