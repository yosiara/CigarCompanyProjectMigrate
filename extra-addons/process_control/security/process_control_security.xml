<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_manufacturing_control">
        <field name="name">Process Control</field>
        <field name="sequence">7</field>
        <field name="parent_id" ref="base.module_category_manufacturing"/>
    </record>
    
    <record id="group_process_control_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_manufacturing_control"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    
    <record id="group_process_control_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_manufacturing_control"/>
        <field name="implied_ids" eval="[(4, ref('group_process_control_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    
    <data noupdate="1">
        <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('process_control.group_process_control_user'))]"/>
        </record>
    </data>
</odoo>