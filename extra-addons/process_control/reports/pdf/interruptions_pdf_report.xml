<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="interruptions_pdf_report">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>Summary of Interruptions since <t t-out="start_date"/> until <t t-out="end_date"/></h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <t t-if="filt == 'machine'">
                                        <th>Machine</th>
                                        <th>Set of Peaces</th>
                                    </t>
                                    <t t-elif="filt == 'productive_line'">
                                        <th>Productive Line</th>
                                    </t>
                                    <t t-else="">
                                        <th>Productive Section</th>
                                    </t>
                                    <th>Interruption Type</th>
                                    <th>Number</th>
                                    <th>Time (hours)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Machine -->
                                <t t-if="filt == 'machine'">
                                    <tr t-foreach="res" t-as="machine">
                                        <td t-att-rowspan="total[machine]['rowspan']+2" align="center" valign="middle">
                                            <t t-out="machine"/>
                                        </td>
                                        <tr t-foreach="res[machine]" t-as="subset">
                                            <td t-att-rowspan="len(res[machine][subset])+1" align="center" valign="middle">
                                                <t t-out="subset"/>
                                            </td>
                                            <tr t-foreach="res[machine][subset]" t-as="type">
                                                <td>
                                                    <t t-out="type"/>
                                                </td>
                                                <td class="text-center">
                                                    <t t-out="res[machine][subset][type]['number']"/>
                                                </td>
                                                <td class="text-center">
                                                    <t t-out="res[machine][subset][type]['time']"/>
                                                </td>
                                            </tr>
                                        </tr>
                                        <tr>
                                            <th colspan="2">Subtotal</th>
                                            <th>
                                                <t t-out="total[machine]['number']"/>
                                            </th>
                                            <th>
                                                <t t-out="total[machine]['time']"/>
                                            </th>
                                        </tr>
                                    </tr>
                                </t>
                                <!-- Other -->
                                <t t-else="">
                                    <tr t-foreach="res" t-as="ent">
                                        <t t-set="interruption_type_count" t-value="len(res[ent])+2"/>
                                        <td t-att-rowspan="interruption_type_count" align="center" valign="middle">
                                            <t t-out="ent"/>
                                        </td>
                                        <tr t-foreach="res[ent]" t-as="type">
                                            <td>
                                                <t t-out="type"/>
                                            </td>
                                            <td class="text-center">
                                                <t t-out="res[ent][type]['number']"/>
                                            </td>
                                            <td class="text-center">
                                                <t t-out="res[ent][type]['time']"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Subtotal</th>
                                            <th>
                                                <t t-out="total[ent]['number']"/>
                                            </th>
                                            <th>
                                                <t t-out="total[ent]['time']"/>
                                            </th>
                                        </tr>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr style="font-size: 17px;">
                                    <t t-if="filt == 'machine'">
                                        <th colspan="3">Total</th>
                                    </t>
                                    <t t-else="">
                                        <th colspan="2">Total</th>
                                    </t>
                                    <th>
                                        <t t-out="total['Total']['number']"/>
                                    </th>
                                    <th>
                                        <t t-out="total['Total']['time']"/>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <record id="interruptions_pdf_report_action" model="ir.actions.report">
            <field name="name">Interruptions Report</field>
            <field name="model">process_control.interruptions_pdf_report_wzd</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">process_control.interruptions_pdf_report</field>
            <field name="report_file">process_control.interruptions_pdf_report</field>
            <field name="binding_type">report</field>
        </record>

