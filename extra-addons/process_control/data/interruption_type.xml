<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="interruption_type_PM" model="process_control.interruption_type">
            <field name="name">Problema mecánico</field>
            <field name="code">PM</field>
            <field name="use_in_any_machine" eval="True"/>
            <field name="is_linked_to_machine" eval="True"/>
            <field name="cause">endogena</field>
        </record>
        <record id="interruption_type_PE" model="process_control.interruption_type">
            <field name="name">Problema eléctrico</field>
            <field name="code">PE</field>
            <field name="use_in_any_machine" eval="True"/>
            <field name="is_linked_to_machine" eval="True"/>
            <field name="cause">endogena</field>
        </record>
        <record id="interruption_type_MP" model="process_control.interruption_type">
            <field name="name">Mantenimiento Planificado</field>
            <field name="code">MP</field>
            <field name="use_in_any_machine" eval="True"/>
            <field name="is_linked_to_machine" eval="True"/>
            <field name="cause">endogena</field>
        </record>
        <record id="interruption_type_PC" model="process_control.interruption_type">
            <field name="name">Problema de Calidad</field>
            <field name="code">PC</field>
            <field name="is_linked_to_machine" eval="True"/>
            <field name="cause">endogena</field>
            <!--Vinculadas a MK8, AMF, CP1 y Minipar.-->
            <field name="machines_related"
                   eval="[
                   (4,ref('machine_type_1')),
                   (4,ref('machine_type_4')),
                   (4,ref('machine_type_6')),
                   (4,ref('machine_type_7')),
                  ]"/>
        </record>
        <record id="interruption_type_EN" model="process_control.interruption_type">
            <field name="name">Encaje</field>
            <field name="code">EN</field>
            <field name="is_linked_to_machine" eval="True"/>
            <field name="cause">endogena</field>
            <!--Vinculadas a MK8, NANO.-->
            <field name="machines_related"
                   eval="[(4,ref('machine_type_1')),
                   (4,ref('machine_type_9')),
                   ]"/>
        </record>
        <record id="interruption_type_OE" model="process_control.interruption_type">
            <field name="name">Objetos extraños</field>
            <field name="code">OE</field>
            <field name="cause">endogena</field>
            <field name="is_linked_to_machine" eval="True"/>
            <!--Vinculadas a MK8, NANO.-->
            <field name="machines_related"
                   eval="[(4,ref('machine_type_1')),
                   (4,ref('machine_type_9')),
                   ]"/>
        </record>
        <record id="interruption_type_FH" model="process_control.interruption_type">
            <field name="name">Falta de hebra</field>
            <field name="code">FH</field>
            <field name="is_linked_to_machine" eval="True"/>
            <field name="cause">endogena</field>
            <!--Vinculadas a MK8, NANO.-->
            <field name="machines_related"
                   eval="[(4,ref('machine_type_1')),
                   (4,ref('machine_type_9')),
                   ]"/>
        </record>

        <record id="interruption_type_FE" model="process_control.interruption_type">
            <field name="name">Falta de energía</field>
            <field name="code">FE</field>
            <field name="cause">exogena</field>
        </record>

        <record id="interruption_type_FAC" model="process_control.interruption_type">
            <field name="name">Falta de aire comprimido</field>
            <field name="code">FAC</field>
            <field name="cause">exogena</field>
        </record>
        <record id="interruption_type_FC" model="process_control.interruption_type">
            <field name="name">Falta de cigarros</field>
            <field name="code">FC</field>
            <field name="cause">exogena</field>
        </record>
        <record id="interruption_type_FM" model="process_control.interruption_type">
            <field name="name">Falta de materiales</field>
            <field name="code">FM</field>
            <field name="cause">exogena</field>
        </record>
        <record id="interruption_type_MD" model="process_control.interruption_type">
            <field name="name">Materiales defectuosos</field>
            <field name="code">MD</field>
            <field name="cause">exogena</field>
        </record>
        <record id="interruption_type_P" model="process_control.interruption_type">
            <field name="name">Preparación</field>
            <field name="code">P</field>
            <field name="cause">exogena</field>
        </record>
        <record id="interruption_type_FO" model="process_control.interruption_type">
            <field name="name">Tiempo perdido (falta personal)</field>
            <field name="code">FO</field>
            <field name="cause">endogena</field>
        </record>
        <record id="interruption_type_OEN" model="process_control.interruption_type">
            <field name="name">Otros (Endogeno)</field>
            <field name="code">OEN</field>
            <field name="cause">endogena</field>
        </record>

        <record id="interruption_type_OEX" model="process_control.interruption_type">
            <field name="name">Otros (Exogena)</field>
            <field name="code">OEX</field>
            <field name="cause">endogena</field>
        </record>
    </data>
</odoo>