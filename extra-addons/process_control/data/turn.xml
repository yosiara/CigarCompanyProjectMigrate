<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- Turnos -->
        <record id="turn_1" model="process_control.turn">
            <field name="name">Turno 1</field>
        </record>
        <record id="turn_2" model="process_control.turn">
            <field name="name">Turno 2</field>
        </record>
        
        <!-- Sesiones de trabajo -->
        <record id="turn_attendance_1" model="process_control.turn_attendance">
            <field name="name">Mañana</field>
            <field name="hour_from">7:00</field>
            <field name="hour_to">15:00</field>
            <field name="turn_id" eval="[
                (4,ref('turn_1')),
            ]"/>
        </record>
        <record id="turn_attendance_2" model="process_control.turn_attendance">
            <field name="name">Tarde</field>
            <field name="hour_from">15:00</field>
            <field name="hour_to">23:00</field>
            <field name="turn_id" eval="[
                (4,ref('turn_1')),
            ]"/>
        </record>
        <record id="turn_attendance_3" model="process_control.turn_attendance">
            <field name="name">Mañana</field>
            <field name="hour_from">7:00</field>
            <field name="hour_to">15:00</field>
            <field name="turn_id" eval="[
                (4,ref('turn_2')),
            ]"/>
        </record>
        <record id="turn_attendance_4" model="process_control.turn_attendance">
            <field name="name">Tarde</field>
            <field name="hour_from">15:00</field>
            <field name="hour_to">23:00</field>
            <field name="turn_id" eval="[
                (4,ref('turn_2')),
            ]"/>
    </data>
</odoo>