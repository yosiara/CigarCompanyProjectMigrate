<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="turn_attendance_form" model="ir.ui.view">
                <field name="name">turn_attendance.form</field>
                <field name="model">process_control.turn_attendance</field>
                <field name="arch" type="xml">
                    <form>
                        <sheet>
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="turn_id"/>
                                    <field name="session"/>
                                </group>
                                <group>
                                    <field name="hour_from" widget="float_time"/>
                                    <field name="hour_to" widget="float_time"/>
                                </group>
                            </group>
                        </sheet>
                    </form>
                </field>
        </record>

        <record id="turn_attendance_list" model="ir.ui.view">
            <field name="name">turn_attendance.list</field>
            <field name="model">process_control.turn_attendance</field>
            <field name="arch" type="xml">
               <list>
                    <field name="name"/>
                    <field name="session"/>
                    <field name="hour_from" widget="float_time"/>
                    <field name="hour_to" widget="float_time"/>
                    <field name="turn_id"/>
                </list>
            </field>
        </record>
        
        <record id="turn_attendance_action" model="ir.actions.act_window">
            <field name="name">Work Detail</field>
            <field name="res_model">process_control.turn_attendance</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>