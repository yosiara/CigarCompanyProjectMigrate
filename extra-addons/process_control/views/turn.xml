<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="turn_view_form" model="ir.ui.view">
                <field name="name">turn.form</field>
                <field name="model">process_control.turn</field>
                <field name="arch" type="xml">
                    <form string="Working Time">
                        <sheet string="Working Time">
                            <h1>
                                <field name="name"/>
                            </h1>
                            <separator/>
                            <notebook>
                                <page string="Working Hours" name="working_hours">
                                    <field name="turn_attendance_ids" widget="section_one2many">
                                        <tree string="Working Time" editable="bottom" multi_edit="1">
                                            <field name="name"/>
                                            <field name="hour_from" widget="float_time"/>
                                            <field name="hour_to" widget="float_time"/>
                                        </tree>
                                        <!-- <form string="Working Time">
                                            <sheet>
                                                <group>
                                                    <group>
                                                        <field name="name"/>
                                                        <field name="turn_id"/>
                                                    </group>
                                                    <label for="hour_from" string="Hours"/>
                                                    <group>
                                                        <field name="hour_from" widget="float_time"/>
                                                        <field name="hour_to" widget="float_time"/>
                                                    </group>
                                                </group>
                                            </sheet>
                                        </form> -->
                                    </field>
                                </page>
                            </notebook>
                        </sheet>
                    </form>
                </field>
            </record>

            <record id="view_turn_tree" model="ir.ui.view">
                <field name="name">turn.tree</field>
                <field name="model">process_control.turn</field>
                <field name="arch" type="xml">
                    <tree string="Working Time">
                        <field name="name"/>
                        <field name="turn_attendance_ids" widget="many2many_tags"/>
                    </tree>
                </field>
            </record>

            <record id="action_turn_form" model="ir.actions.act_window">
                <field name="name">Turnos de trabajo</field>
                <field name="res_model">process_control.turn</field>
                <field name="view_mode">tree,form</field>
                <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Define working hours and time table that could be scheduled to your project members
                </p>
                </field>
            </record>
            
            <menuitem action="action_turn_form" id="menu_turn" parent="process_control_settings_menu" sequence="1"/>

