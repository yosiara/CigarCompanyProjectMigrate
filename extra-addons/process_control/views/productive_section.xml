<?xml version="1.0"?>
<odoo>
    <data>
        <record id="productive_section_form" model="ir.ui.view">
            <field name="name">productive_section_form</field>
            <field name="model">process_control.productive_section</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <!-- <field name="production_id"/> -->
                            </group>
                            <group>
                                <!-- <field name="tec_model_type"/> -->
                                <field name="productive_section_plan_id" domain="[('activate', '=', True)]"/>
                            </group>

                            <notebook>
                                <page string="Productive Lines" name="productive_line">
                                    <field name="productive_line_ids" readonly="1">
                                        <list>
                                            <field name="name"/>
                                            <field name="machine_ids"/>
                                        </list>
                                    </field>
                                </page>
                                <page string="Machines" name="machine">
                                    <field name="machine_ids" readonly="1">
                                        <list>
                                            <field name="name" placeholder="Type-Module-Line"/>
                                            <field name="machine_type_id"/>
                                            <field name="line_domain" column_invisible="1"/>
                                            <field name="productive_line_id" domain="line_domain"/>
                                            <field name="set_of_peaces"/>
                                        </list>
                                    </field>
                                </page>
                            </notebook>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="productive_section_list" model="ir.ui.view">
            <field name="name">productive_section_list</field>
            <field name="model">process_control.productive_section</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <!-- <field name="tec_model_type"/> -->
                    <field name="productive_section_plan_id"/>
                    <field name="productive_line_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="productive_section_action" model="ir.actions.act_window">
            <field name="name">Productive Sections</field>
            <field name="res_model">process_control.productive_section</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples. Click here to add new Productive Section.
                </p>
            </field>
        </record>

        <menuitem id="productive_section_menu" parent="menu_process_control_settings" action="productive_section_action" sequence="20"/>
    </data>
</odoo>
