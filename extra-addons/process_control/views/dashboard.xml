<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="graph_interruption" model="ir.ui.view">
            <field name="name">process_control.interruption.graph</field>
            <field name="model">process_control.interruption</field>
            <field name="arch" type="xml">
                <graph string="Interruptions" type="pie">
                    <field name="interruption_type_id" type="row"/>
                </graph>
            </field>
        </record>

        <record id="dashboard_view" model="ir.actions.act_window">
            <field name="name">Interruption Details</field>
            <field name="res_model">process_control.interruption</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">graph</field>
        </record>

        <menuitem id="dashboard_edit" name="Dashboard" parent="menu_proccess_control_root" action="dashboard_view" sequence="-1"/>
    </data>
</odoo>