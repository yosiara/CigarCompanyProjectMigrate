<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="tecnolog_control_search" model="ir.ui.view">
            <field name="name">tecnolog_control.search</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <search>
                    <field name="date"/>
                    <field name="productive_section_id"/>
                    <field name="turn_id"/>
                    <filter string="Mañana" name="morning" domain="[('session', '=', 'morning')]"/>
                    <separator/>
                    <filter string="Tarde" name="afternoon" domain="[('session', '=', 'afternoon')]"/>
                    <separator/>
                    <group name="group_by" string="Group By">
                        <filter name="group_date" string="Fecha" context="{'group_by': 'date'}"/>
                        <separator/>
                        <filter name="group_section" string="Módulo" context="{'group_by': 'productive_section_id'}"/>
                        <separator/>
                        <filter name="group_turn" string="Turno" context="{'group_by': 'turn_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="tecnolog_control_tree" model="ir.ui.view">
            <field name="name">tecnolog_control.tree</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="date"/>
                    <field name="productive_section_id"/>
                    <field name="turn_id"/>
                    <field name="plan_time"/>
                    <field name="productive_capacity"/>
                </tree>
            </field>
        </record>

        <record id="tecnolog_control_form" model="ir.ui.view">
            <field name="name">tecnolog_control.form</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group col="3">
                            <group>
                                <field name="date"/>
                                <field name="productive_section_id"/>
                            </group>
                            <group>
                                <field name="turn_id"/>
                                <field name="session"/>
                            </group>
                            <group>
                                <field name="plan_time" readonly="1"/>
                                <field name="productive_capacity" readonly="1"/>
                            </group>
                        </group>

                        <notebook invisible="productive_section_id == False">
                            <page string="Interrupciones">
                                <field name="interruption_ids"/>
                            </page>
                            <page string="Producción Horaria">
                                <field name="production_by_hours_ids"/>
                            </page>
                            <page string="Producción y Rechazo">
                                <field name="rechazo_amf_ids" invisible="productive_section_id == 1"/>
                                <field name="rechazo_mod1_ids" invisible="productive_section_id != 1"/>
                            </page>
                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="tecnolog_control_action" model="ir.actions.act_window">
            <field name="name">Control Tecnológico</field>
            <field name="res_model">process_control.tecnolog_control</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="context">{'search_default_group_date': 1}</field> -->
        </record>

        <menuitem id="tecnolog_control_menu" name="Ingreso Inter/Producción" parent="process_control_control_tec" action="tecnolog_control_action" sequence="10"/>
    </data>
</odoo>