<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="process_control_interrupciones_view_search" model="ir.ui.view">
            <field name="name">Control model search view</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <search string="Modelo de control">
                    <field name="date"/>
                    <field name="productive_section_id"/>
                    <field name="turn_calendar_id"/>
                    <filter name="group_year" string="Por año"
                            context="{'group_by': 'year_char'}"
                    />
                    <filter name="group_date1" string="Por fecha"
                            context="{'group_by': 'date'}"
                    />
                    <filter name="group_day" string="Por día"
                            context="{'group_by': 'day_char'}"
                    />
                    <filter name="group_seccion" string="Por Modulo"
                        context="{'group_by': 'productive_section_id'}"
                    />
                </search>
            </field>
        </record>

        <!-- <act_window id="process_control_interruptiones_action"
                    name="Control tecnológico"
                    res_model="process_control.tecnolog_control"
                    view_mode="tree,form"
                    context="{'search_default_group_year': 1, 'search_default_group_date1': 1, 'search_default_group_day': 1}"
        /> -->

        <record id="process_control_interruptiones_action" model="ir.actions.act_window">
            <field name="name">Control tecnológico</field>
            <field name="res_model">process_control.tecnolog_control</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_group_year': 1, 'search_default_group_date1': 1, 'search_default_group_day': 1}</field>
        </record>

        <menuitem id="process_control_interruptiones_menu"
                  name="Ingreso Inter/producción"
                  parent="process_control_control_tec"
                  action="process_control_interruptiones_action"
                  sequence="10"
        />

        <record id="tecnolog_control_view_tree" model="ir.ui.view">
            <field name="name">control_proc_interruption_type_view_tree</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="year_char" invisible="1"/>
                    <field name="day_char" invisible="1"/>
                    <field name="date"/>
                    <field name="productive_section_id"/>
                    <field name="turn_calendar_id"/>
                </tree>
            </field>
        </record>

        <record id="control_proc_interruptiones_view_form" model="ir.ui.view">
            <field name="name">process_control_interrupciones_view_form</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="turn_calendar_id" options="{'no_create_edit': True}"/>
                                <field name="attendance_id" options="{'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="productive_section_id"/>
                                <field name="productive_capacity"/>
                                <field name="plan_time"/>
                            </group>
                            <!-- <group>
                                <field name="tec_model_type" invisible="1"/>
                            </group> -->
                        </group>
                            <notebook>
                                <page string="Interrupciones">
                                    <field name="interruption_ids">
                                        <tree editable="bottom">
                                            <field name="productive_line_id"
                                                   domain="[('productive_section_id', '=', parent.productive_section_id)]"/>
                                            <field name="machine_id"/>
                                            <field name="interruption_type"/>
                                            <field name="set_of_peaces_id"/>
                                            <field name="start_date"/>
                                            <field name="end_date"/>
                                            <!-- <field name="time" widget="xls_formula"/>
                                            <field name="frequency" widget="xls_formula"/> -->
                                        </tree>
                                    </field>
                                </page>
                                <page string="Producción Horaria">
                                    <group>
                                        <!-- <field name="production_in_production_system"/> -->
                                        <field name="production_in_proccess_control"/>
                                    </group>
                                    <field name="production_by_hours_ids"
                                           readonly="attendance_id == False">
                                        <tree editable="bottom">
                                            <field name="hour_production"/>
                                            <field name="production_count" widget="xls_formula"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Producción y rechazo">
                                    <field name="rechazo_mod1_ids">
                                           <!-- invisible="tec_model_type == 'mod' | productive_section_id ==  False"> -->
                                        <!-- <div class="alert alert-info">
                                            <strong>Información:</strong>
                                            Se capta la producción y rechazo de las máquinas 'NANO', 'SBO', 'SRC'
                                        </div> -->

                                        <tree editable="bottom">
                                            <field name="productive_line_id"/>
                                                   <!-- domain="[('productive_section_id', '=', parent.productive_section_id)]"/> -->
                                            <field name="machine_id"/>
                                            <!-- <field name="machine_type_id" invisible="1"/> -->
                                            <!-- <field name="machine_type_name" invisible="1"/> -->
                                            <field name="produccion_en_cigarrillos"/>
                                                   <!-- invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/> -->
                                            <field name="rechazo_en_cigarrillos"/>
                                                   <!-- invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/> -->
                                            <field name="produccion_en_cajones"/>
                                                   <!-- invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/> -->
                                            <field name="rechazo_en_cajetillas"/>
                                                   <!-- invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/> -->
                                        </tree>

                                        <form>
                                            <group col="8">
                                                <group colspan="4">
                                                    <field name="productive_line_id"
                                                           domain="[('productive_section_id', '=', parent.productive_section_id)]"/>
                                                </group>
                                                <group colspan="4">
                                                    <field name="machine_id"/>
                                                    <field name="machine_type_id" invisible="1"/>
                                                    <!-- <field name="machine_type_name" invisible="1"/> -->
                                                </group>
                                            </group>
                                            <group col="8">
                                                <group colspan="4">
                                                    <field name="produccion_en_cigarrillos"
                                                           invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/>
                                                    <field name="rechazo_en_cigarrillos"
                                                           invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/>
                                                </group>
                                                <group colspan="4">
                                                    <field name="produccion_en_cajones"
                                                           invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/>
                                                    <field name="rechazo_en_cajetillas"
                                                           invisible="machine_type_id.name != 'NANO' | machine_type_id.name == False" widget="xls_formula"/>
                                                </group>
                                            </group>
                                        </form>
                                    </field>
                                    <!-- <field name="rechazo_amf_ids"
                                           invisible="tec_model_type == 'mod1' | productive_section_id == False">
                                        <div class="alert alert-info">
                                            <strong>Información:</strong>
                                            Se capta la producción y rechazo de las AMF
                                        </div>
                                        <tree editable="bottom">
                                            <field name="productive_line_id"
                                                   domain="[('productive_section_id', '=', parent.productive_section_id)]"/>
                                            <field name="machine_id"/>
                                            <field name="machine_type_id" invisible="1"/>
                                            <field name="produccion_en_cajones" widget="xls_formula"/>
                                            <field name="rechazo_en_cajetijas" widget="xls_formula"/>
                                        </tree>
                                    </field> -->
                                </page>
                            </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                    </div>
                </form>
            </field>
        </record>
    </data>
</odoo>