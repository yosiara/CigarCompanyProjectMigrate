<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="tecnolog_control_search" model="ir.ui.view">
            <field name="name">tecnolog_control.search</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <search>
                    <field name="date"/>
                    <field name="productive_section_id"/>
                    <field name="turn_id"/>
                    <filter string="Morning" name="morning" domain="[('session', '=', 'morning')]"/>
                    <separator/>
                    <filter string="Afternoon" name="afternoon" domain="[('session', '=', 'afternoon')]"/>
                    <separator/>
                    <group name="group_by" string="Group By">
                        <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                        <separator/>
                        <filter name="group_section" string="Productive Section" context="{'group_by': 'productive_section_id'}"/>
                        <separator/>
                        <filter name="group_turn" string="Turn" context="{'group_by': 'turn_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="tecnolog_control_list" model="ir.ui.view">
            <field name="name">tecnolog_control.list</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="productive_section_id"/>
                    <field name="turn_id"/>
                    <field name="plan_time"/>
                    <field name="productive_capacity"/>
                </list>
            </field>
        </record>

        <record id="tecnolog_control_form" model="ir.ui.view">
            <field name="name">tecnolog_control.form</field>
            <field name="model">process_control.tecnolog_control</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group col="3">
                            <group>
                                <field name="date"/>
                                <field name="productive_section_id"/>
                            </group>
                            <group>
                                <field name="turn_id"/>
                                <field name="session"/>
                            </group>
                            <group>
                                <field name="plan_time" readonly="1"/>
                                <field name="productive_capacity" readonly="1"/>
                            </group>
                        </group>

                        <notebook invisible="productive_section_id == False">
                            <page string="Interruptions">
                                <field name="interruption_ids"/>
                            </page>
                            <page string="Hourly Production">
                                <field name="production_by_hours_ids"/>
                            </page>
                            <page string="Production and Rejection">
                                <field name="rejection_amf_ids" invisible="productive_section_id == 1"/>
                                <field name="rejection_mod1_ids" invisible="productive_section_id != 1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tecnolog_control_action" model="ir.actions.act_window">
            <field name="name">Technological Control</field>
            <field name="res_model">process_control.tecnolog_control</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples. Click here to add new Interruption/Production.
                </p>
            </field>
        </record>

        <menuitem id="tecnolog_control_menu" name="Interruption/Production" parent="menu_process_control_tech_control" action="tecnolog_control_action" sequence="10"/>
    </data>
</odoo>