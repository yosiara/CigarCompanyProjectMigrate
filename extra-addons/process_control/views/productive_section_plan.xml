<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="productive_section_plan_form" model="ir.ui.view">
            <field name="name">productive_section_plan_view_form</field>
            <field name="model">process_control.productive_section_plan</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group col="3">
                            <group>
                                <field name="name"/>
                                <field name="year"/>
                                <field name="activate" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="productive_capacity"/>
                                <field name="quantity_line"/>
                                <field name="indice_planif_norma"/>
                            </group>
                            <group>
                                <field name="indice_planif_efici_real"/>
                                <field name="indice_planif_rechazo"/>
                                <field name="indice_planif_disp_tec"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="productive_section_plan_list" model="ir.ui.view">
            <field name="name">productive_section_plan_view_list</field>
            <field name="model">process_control.productive_section_plan</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="year"/>
                    <field name="activate" widget="boolean_toggle"/>
                    <field name="productive_capacity"/>
                    <field name="quantity_line"/>
                    <field name="indice_planif_efici_real"/>
                    <field name="indice_planif_rechazo"/>
                    <field name="indice_planif_disp_tec"/>
                    <field name="indice_planif_norma"/>
                </list>
            </field>
        </record>

        <record id="productive_section_plan_action" model="ir.actions.act_window">
            <field name="name">Planificación de Norma e Indicadores</field>
            <field name="res_model">process_control.productive_section_plan</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="productive_section_plan_menu" name="Planes de Trabajo" parent="process_control_settings_menu" action="productive_section_plan_action" sequence="38"/>
    </data>
</odoo>