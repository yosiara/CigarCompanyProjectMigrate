<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="machine_type_form" model="ir.ui.view">
            <field name="name">machine_type_form</field>
            <field name="model">process_control.machine_type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group colspan="1">
                                <field name="name"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="machine_type_list" model="ir.ui.view">
            <field name="name">machine_type_list</field>
            <field name="model">process_control.machine_type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="machine_type_action" model="ir.actions.act_window">
            <field name="name">Tipos de Máquinas</field>
            <field name="res_model">process_control.machine_type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="machine_type_menu" parent="process_control_settings_menu" action="machine_type_action" sequence="34"/>
    </data>
</odoo>