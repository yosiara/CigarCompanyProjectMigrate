<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="interruption_tree" model="ir.ui.view">
            <field name="name">interruption_tree</field>
            <field name="model">process_control.interruption</field>
            <field name="arch" type="xml">
                <tree class="alig-left-fields">
                    <!-- <field name="name"/> -->
                    <field name="start_date" class="alig-left-fields"/>
                    <field name="end_date"/>
                    <field name="interruption_type_id"/>
                    <field name="productive_line_id"/>
                    <field name="machine_id"/>
                    <field name="set_of_peaces_id"/>
                    <!-- <field name="time"/> -->
                </tree>
            </field>
        </record>

        <record id="interruption_form" model="ir.ui.view">
            <field name="name">interruption_form</field>
            <field name="model">process_control.interruption</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="line_domain" invisible="1"/>
                        <field name="machine_domain" invisible="1"/>
                        <field name="peaces_domain" invisible="1"/>
                        <field name="interruption_type_domain" invisible="1"/>
                        <group col="3">
                            <group>
                                <field name="start_date" widget="float_time"/>
                                <field name="end_date" widget="float_time"/>
                                <field name="productive_line_id" domain="line_domain"/>
                            </group>
                            <group colspan="2">
                                <field name="machine_id" domain="machine_domain"/>
                                <field name="set_of_peaces_id" domain="peaces_domain"/>
                                <field name="interruption_type_id" domain="interruption_type_domain"/>
                            </group>
                            <!-- <field name="time"/> -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="interruption_action" model="ir.actions.act_window">
            <field name="name">Interrupciones</field>
            <field name="res_model">process_control.interruption</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>