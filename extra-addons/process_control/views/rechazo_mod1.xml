<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="rechazo_mod1_form" model="ir.ui.view">
            <field name="name">rechazo_mod1.form</field>
            <field name="model">process_control.rechazo_mod1</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="rechazo_id" invisible="1"/>
                        <group>
                            <group>
                                <field name="turn_attendance_id" domain="[('session', '=', parent.session), ('turn_id', '=', parent.turn_id)]"/>
                                <field name="productive_line_id"/>
                                <field name="machine_id"/>
                            </group>
                            <group>
                                <field name="prod_en_cigarrillos"/>
                                <field name="rechazo_en_cigarrillos"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rechazo_mod1_tree" model="ir.ui.view">
            <field name="name">rechazo_mod1.tree</field>
            <field name="model">process_control.rechazo_mod1</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="turn_attendance_id"/>
                    <field name="productive_line_id"/>
                    <field name="machine_id"/>
                    <field name="prod_en_cigarrillos"/>
                    <field name="rechazo_en_cigarrillos"/>
                </tree>
            </field>
        </record>

        <record id="rechazo_mod1_action" model="ir.actions.act_window">
            <field name="name">Rechazo Módulo 1</field>
            <field name="res_model">process_control.rechazo_mod1</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>