<?xml version="1.0"?>
<odoo>
    <data>
        <record id="control_proc_productive_line_view_form" model="ir.ui.view">
            <field name="name">process_control_productive_line_view_form</field>
            <field name="model">process_control.productive_line</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="productive_section_id"/>
                            </group>
                            <!-- <group colspan="2">
                                <field name="machine_ids" widget="many2many_tags"/>
                            </group> -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="productive_line_list" model="ir.ui.view">
            <field name="name">productive_line_list</field>
            <field name="model">process_control.productive_line</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="productive_section_id"/>
                    <field name="machine_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="productive_line_action" model="ir.actions.act_window">
            <field name="name">Líneas Productivas</field>
            <field name="res_model">process_control.productive_line</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="productive_line_menu" parent="process_control_settings_menu" action="productive_line_action" sequence="30"/>
    </data>
</odoo>
