<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="production_by_hours_form" model="ir.ui.view">
            <field name="name">production_by_hours.form</field>
            <field name="model">process_control.production_by_hours</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="turn_att_id" domain="[('session', '=', parent.session), ('turn_id', '=', parent.turn_id)]"/>
                            </group>
                            <group>
                                <field name="production_count"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="production_by_hours_tree" model="ir.ui.view">
            <field name="name">production_by_hours.tree</field>
            <field name="model">process_control.production_by_hours</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="turn_att_id" domain="[('session', '=', parent.session), ('turn_id', '=', parent.turn_id)]"/>
                    <field name="production_count"/>
                </tree>
            </field>
        </record>

        <record id="production_by_hours_action" model="ir.actions.act_window">
            <field name="name">Producción Horaria</field>
            <field name="res_model">process_control.production_by_hours</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>