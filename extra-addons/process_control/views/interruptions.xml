<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- <act_window id="turei_process_interruptions_action"
                    name="Interrupciones"
                    res_model="process_control.interruption"
                    view_mode="tree,form"/> -->

        <record id="turei_process_interruptions_action" model="ir.actions.act_window">
            <field name="name">Interrupciones</field>
            <field name="res_model">process_control.interruption</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!--<menuitem id="turei_process_interruptions_menu"-->
                  <!--name="Listado de interrupciones"-->
                  <!--parent="process_control_control_tec"-->
                  <!--action="turei_process_interruptions_action"-->
                  <!--sequence="11"-->
        <!--/>-->

        <record id="process_control_interrupciones_view_tree" model="ir.ui.view">
            <field name="name">control_proc_interruption_view_tree</field>
            <field name="model">process_control.interruption</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="productive_line_id"/>
                    <field name="interruption_type"/>
                    <field name="machine_id"/>
                    <field name="set_of_peaces_id"/>
                    <!-- <field name="time"/> -->
                </tree>
            </field>
        </record>

        <record id="process_control_interrupciones_view_form" model="ir.ui.view">
            <field name="name">control_proc_interruption_view_form</field>
            <field name="model">process_control.interruption</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group col="3">
                            <group>
                                <field name="start_date" widget="float_time"/>
                                <field name="end_date" widget="float_time"/>
                                <field name="interruption_type"/>
                            </group>
                            <group colspan="2">
                                <field name="productive_line_id"/>
                                <field name="machine_id"/>
                                <field name="set_of_peaces_id"/>
                            </group>
                            <!-- <field name="time"/> -->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>