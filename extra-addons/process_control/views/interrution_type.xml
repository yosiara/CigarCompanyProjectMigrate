<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="interruption_type_form" model="ir.ui.view">
            <field name="name">interruption_type_form</field>
            <field name="model">process_control.interruption_type</field>
            <field name="arch" type="xml">
                <form string="Tipo de Interrupciones">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="activate" widget="boolean_toggle"/>
                                <field name="cause"/>
                            </group>
                            <group string="Tipo de máquinas asociadas" colspan="2">
                                <field name="machine_type_related" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="interruption_type_tree" model="ir.ui.view">
            <field name="name">interruption_type_tree</field>
            <field name="model">process_control.interruption_type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="cause"/>
                    <field name="activate" widget="boolean_toggle"/>
                    <field name="machine_type_related" widget="many2many_tags"/>
                </tree>
            </field>
        </record>

        <record id="interruption_type_action" model="ir.actions.act_window">
            <field name="name">Tipos de Interrupciones</field>
            <field name="res_model">process_control.interruption_type</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="interruption_type_menu" parent="process_control_settings_menu" action="interruption_type_action" sequence="40"/>
    </data>
</odoo>