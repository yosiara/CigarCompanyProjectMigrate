<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="wzd_production_rejection_to_excel_report_form" model="ir.ui.view">
            <field name="name">process_control.production_rejection_to_excel_wzd.report.form</field>
            <field name="model">process_control.production_rejection_to_excel_wzd</field>
            <field name="arch" type="xml">
                <form string="Rep. Control de Producción y Rechazo">
                    <sheet>
                        <style>
                            td.o_td_label
                            {
                                min-width:88px !important;
                            }
                        </style>
                        <group col="4">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group col="4">
                            <group colspan="2">
                                <field name="turn" options="{'no_create_edit': True}"/>
                            </group>
                        </group>


                        <footer>
                            <div>
                                <button name="export_to_xls" icon="fa-file-excel-o" string="Imprimir" type="object"
                                        class="oe_highlight"/>
                                o
                                <button special="cancel" string="Cancelar" class="oe_link"/>
                            </div>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wzd_production_rejection_to_excel_report_act_window" model="ir.actions.act_window">
            <field name="name">Rep. Control de Producción y Rechazo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">process_control.production_rejection_to_excel_wzd</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="wzd_production_rejection_to_excel_report_act_window"
                  id="wzd_production_rejection_to_excel_report_report" parent="process_control_informes_xls" sequence="10"/>
    </data>
</odoo>