<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="wzd_interruptions_excel_report_form" model="ir.ui.view">
            <field name="name">process_control.interruptions_excel_wzd.report.form</field>
            <field name="model">process_control.interruptions_excel_wzd</field>
            <field name="arch" type="xml">
                <form string="Interruptions Report">
                    <sheet>
                        <style>
                            td.o_td_label
                            {
                            min-width:88px !important;
                            }
                        </style>
                        <group col="4">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>

                        <footer>
                            <div>
                                <button name="export_to_xlsx" icon="fa-file-excel-o" string="Print" type="object"
                                        class="oe_highlight"/>
                                o
                                <button special="cancel" string="Cancel" class="oe_link"/>
                            </div>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wzd_interruptions_excel_report_act_window" model="ir.actions.act_window">
            <field name="name">Interruptions Report</field>
            <field name="res_model">process_control.interruptions_excel_wzd</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="wzd_interruptions_excel_report_act_window" id="menu_wzd_interruptions_excel_report_report" parent="menu_process_control_reports_xlsx" sequence="1"/>
    </data>
</odoo>