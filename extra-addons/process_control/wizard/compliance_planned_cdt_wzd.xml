<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="wzd_compliance_planned_cdt_excel_report_form" model="ir.ui.view">
            <field name="name">process_control.compliance_planned_cdt_excel_wzd.form</field>
            <field name="model">process_control.compliance_planned_cdt_excel_wzd</field>
            <field name="arch" type="xml">
                <form string="Planned CDT Compliance Report">
                    <sheet>
                        <style>
                            td.o_td_label
                            {
                                min-width:88px !important;
                            }
                        </style>
                        <group>
                            <group col="2">
                                <field name="start_date"/>
                            </group>
                            <group col="2">
                                <field name="end_date"/>
                            </group>
                        </group>
                        <footer>
                            <div>
                                <button name="export_to_xlsx" icon="fa-file-excel-o" string="Print" type="object"
                                        class="oe_highlight"/>
                                o
                                <button special="cancel" string="Cancel" class="oe_link"/>
                            </div>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wzd_compliance_planned_cdt_excel_act_window" model="ir.actions.act_window">
            <field name="name">Planned CDT Compliance Report</field>
            <field name="res_model">process_control.compliance_planned_cdt_excel_wzd</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
<!-- 
        <menuitem action="wzd_compliance_planned_cdt_excel_act_window"
                  id="menu_wzd_compliance_planned_cdt_excel_report" parent="process_control_reports_xlsx" sequence="6"/> -->
    </data>
</odoo>