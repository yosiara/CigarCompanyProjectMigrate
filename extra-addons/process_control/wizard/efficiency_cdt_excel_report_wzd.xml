<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="wzd_efficiency_cdt_excel_form" model="ir.ui.view">
            <field name="name">process_control.efficiency_cdt_excel_wzd.form</field>
            <field name="model">process_control.efficiency_cdt_excel_wzd</field>
            <field name="arch" type="xml">
                <form string="Eficiencia y CDT">
                    <sheet>
                        <style>
                            td.o_td_label
                            {
                            min-width:88px !important;
                            }
                        </style>
                        <group col="4">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>

                        <footer>
                            <div>
                                <button name="export_to_xlsx" icon="fa-file-excel-o" string="Exportar" type="object"
                                        class="oe_highlight"/>
                                o
                                <button special="cancel" string="Cancelar" class="oe_link"/>
                            </div>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wzd_efficiency_cdt_excel_act_window" model="ir.actions.act_window">
            <field name="name">Rep. Eficiencia y CDT</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">process_control.efficiency_cdt_excel_wzd</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="wzd_efficiency_cdt_excel_act_window"
                  id="menu_wzd_wzd_efficiency_cdt_excel" parent="process_control_informes_xlsx" sequence="2"/>
    </data>
</odoo>