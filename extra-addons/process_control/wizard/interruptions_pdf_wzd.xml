<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="wzd_interruptions_pdf_form" model="ir.ui.view">
            <field name="name">process_control.interruptions_pdf_wzd.form</field>
            <field name="model">process_control.interruptions_pdf_report_wzd</field>
            <field name="arch" type="xml">
                <form string="Rep. Interrupciones">
                    <sheet>
                        <style>
                            td.o_td_label
                            {
                            min-width:88px !important;
                            }
                        </style>
                        <field name="peaces_domain" invisible="1"/>
                        <field name="machine_domain" invisible="1"/>
                        <group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="interruption_type_id"/>
                            </group>
                            <group>
                                <field name="filt" widget="radio"/>
                            </group>
                        </group>
                        <group name="filt" string="Filtrado por">
                            <field name="productive_section_id" invisible="filt != 'productive_section'"/>
                            <field name="productive_line_id" invisible="filt != 'productive_line'"/>
                            <field name="machine_id" domain="machine_domain" invisible="filt != 'machine'"/>
                            <field name="set_of_peaces_id" domain="peaces_domain" invisible="filt != 'machine'"/>
                        </group>
                        <footer>
                            <div>
                                <button name="print_report" icon="fa-print" string="Imprimir" type="object"
                                        class="oe_highlight"/>
                                o
                                <button special="cancel" string="Cancelar" class="oe_link"/>
                            </div>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wzd_interruptions_pdf_act_window" model="ir.actions.act_window">
            <field name="name">Rep. Interrupciones</field>
            <field name="res_model">process_control.interruptions_pdf_report_wzd</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="wzd_interruptions_pdf_act_window"
                  id="menu_interruptions_pdf_report" parent="process_control_informes_pdf" sequence="3"/>
    </data>
</odoo>