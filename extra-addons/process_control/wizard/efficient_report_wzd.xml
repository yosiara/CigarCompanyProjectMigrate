<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="wzd_efficient_report_form" model="ir.ui.view">
            <field name="name">process_control.efficient_report_wzd.form</field>
            <field name="model">process_control.efficient_report_wzd</field>
            <field name="arch" type="xml">
                <form string="Reporte de eficiencia">
                    <sheet>
                        <style>
                            td.o_td_label
                            {
                                min-width:88px !important;
                            }
                        </style>
                        <group col="4">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group col="4">
                            <group colspan="2">
                                <field name="productive_section"/>
                            </group>
                            <group colspan="2">
                                <field name="turn" options="{'no_create_edit': True}"/>
                            </group>
                        </group>
                        <div class="alert alert-info">
                            <strong>Información:</strong>
                            Los campos Turno y Sec. Prod, se usan como filtros en el reporte.
                            Para mostrar la información sin filtrar, dejarlos en blanco.
                        </div>
                        <footer>
                            <div>
                                <button name="print_report" icon="fa-print" string="Imprimir" type="object"
                                        class="oe_highlight"/>
                                o
                                <button special="cancel" string="Cancelar" class="oe_link"/>
                            </div>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="wzd_efficient_report_act_window" model="ir.actions.act_window">
            <field name="name">Reporte de eficiencia</field>
            <field name="res_model">process_control.efficient_report_wzd</field>
            <field name="binding_type">report</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="model_process_control_efficient_report_wzd" />
            <field name="target">new</field>
        </record>

         <menuitem action="wzd_efficient_report_act_window"
                  id="menu_wzd_efficient_report" parent="process_control_informes" sequence="1"/>
    </data>
</odoo>