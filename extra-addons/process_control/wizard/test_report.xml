<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="test_report_excel_report_form" model="ir.ui.view">
            <field name="name">process_control.test_report_excel_wzd_form</field>
            <field name="model">process_control.test_report</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="start_date"/>
                            </group>
                            <group>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <footer>
                            <div>
                                <button name="test_report_excel" icon="fa-file-excel-o" string="Imprimir" type="object"
                                        class="oe_highlight"/>
                                o
                                <button special="cancel" string="Cancelar" class="oe_link"/>
                            </div>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="test_report_excel_act_window" model="ir.actions.act_window">
            <field name="name">Rep. Test</field>
            <field name="res_model">process_control.test_report</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem action="test_report_excel_act_window"
                  id="menu_test_report_excel" parent="menu_proccess_control" sequence="3"/>
    </data>
</odoo>