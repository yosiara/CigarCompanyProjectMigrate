<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <!-- ======================================================================================
		RESPONSIBILITY AREA
		Model: base_cu.responsibility_area
		=========================================================================================== -->

        <!-- FORM VIEW -->
        <record id="base_cu_responsibility_area_form_view" model="ir.ui.view">
            <field name="name">base_cu_responsibility_area_form_view</field>
            <field name="model">base_cu.responsibility_area</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title" col="8">
                        	<h1><field name="name" col="8" colspan="8"/></h1>
                        </div>

                        <group>
                            <group>
                                <field name="code"/>
                            </group>
                            <group/>
                        </group>

                        <label for="cost_center_ids"/>
                        <field name="cost_center_ids">
                            <tree>
                                <field name="code"/>
                                <field name="name"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="base_cu_responsibility_area_tree_view" model="ir.ui.view">
            <field name="name">base_cu_responsibility_area_tree_view</field>
            <field name="model">base_cu.responsibility_area</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code"/>
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <!-- ACTION -->
        <record id="base_cu_responsibility_area_action" model="ir.actions.act_window">
	    	<field name="name">Responsibility Areas</field>
		    <field name="res_model">base_cu.responsibility_area</field>
			<field name="binding_view_types">form</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
                <p class="oe_view_nocontent_create">
              	    Click to create a new <b>Responsibility Area</b>...
                </p>
            </field>
		</record>
    </data>
</odoo>
