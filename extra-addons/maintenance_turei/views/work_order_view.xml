<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
		<!-- ======================================================================================
		WORK ORDER
		=========================================================================================== -->

        <!-- FORM VIEW -->
        <record id="maintenance_turei_work_order_form_view" model="ir.ui.view">
            <field name="name">maintenance_turei_work_order_form_view</field>
            <field name="model">maintenance_turei.work_order</field>
            <field name="arch" type="xml">
            	<form>
					<header>
<!--            			<button name="button_open" string="Abierta" type="object" />-->
<!--            			<button name="button_close" string="Cerrada" type="object" />-->
	                    <field name="state" widget="statusbar" statusbar_visible="created,open,closed,cancel"/>
	                </header>

					<sheet>
						<div class="oe_button_box" name="button_box">
							<button name="button_request" string="Cerrar Mantenimiento" type="object" class="oe_stat_button" icon="fa-ticket"/>
                    	</div>
                    	<group>
            				<group>
            					<field name="code"/>
            					<field name="number"/>
								<field name="number_new" readonly="1"/>
<!--							<field name="type_id"/>-->
								<field name="anir"/>
								<field name="time"/>
								<field name="delivered"/>
            				</group>

            				<group>
								<field name="work_type"/>
								<field name="ready_equipment"/>
            					<field name="opening_date"/>
            					<field name="closing_date"/>
            				</group>
            			</group>

						<notebook>
            				<page string="Información General">
								<br/>
								<group>
									<field name="equipment_or_area"/>
									<field name="equipament_id"/>
									<field name="cycle_id"/>
									<field name="maintenance_request_id" options="{'no_create': True, 'no_edit': True}"/>
								</group>

								<group string="Personas implicadas...">
									<field name="creator_id"/>
									<field name="emitter_id"/>
									<field name="executor_id"/>
									<field name="shutter_id"/>
								</group>

								<group string="Centros de Costos">
									<field name="execute_cost_center_id"/>
									<field name="receive_cost_center_id"/>
								</group>
            				</page>

            				<page string="Productos">
            					<field name="product_order_ids">
									<tree editable="bottom">
										<field name="product_id"/>
										<field name="quantity"/>
									</tree>
								</field>
            				</page>

							<page string="Trabajo Realizado">
                                    <field name="realized_work_ids" context="{'default_equipment_id': equipament_id}">
                                        <tree editable="bottom">
                                            <field name="executor_id"/>
											<field name="code_executor"/>
											<field name="description"/>
											<field name="equipment_id" readonly="1"/>
                                            <field name="type"/>
											<field name="time_hr"/>
											<field name="rate" sum="Total" widget="monetary"/>
											<field name="ready_service"/>
											<field name="note"/>
                                        </tree>
                                    </field>
                                </page>

							<page string="Descripción">
								<br/>
								<field name="note"/>
							</page>
							<page string="Datos de Cancelación..." attrs="{'invisible': [('state', '!=', 'cancel')]}">
								<group>
									<group>
										<field name="user_cancel_id" readonly="1"/>
									</group>
									<group>
										<field name="date_cancel" readonly="1"/>
									</group>
								</group>
								<group string="Motivo">
									<field name="description_cancel" nolabel="1" readonly="1"/>
								</group>
							</page>
            			</notebook>
					</sheet>
	            </form>
	        </field>
	    </record>

        <!-- TREE VIEW -->
        <record id="maintenance_turei_work_order_tree_view" model="ir.ui.view">
            <field name="name">maintenance_turei_work_order_tree_view</field>
            <field name="model">maintenance_turei.work_order</field>
            <field name="arch" type="xml">
            	<tree>
            		<field name="code"/>
            		<field name="number"/>
					<field name="number_new"/>
            		<field name="opening_date"/>
            		<field name="closing_date"/>
            		<field name="equipament_id"/>
					<field name="category_id"/>
					<field name="line_id"/>
                    <field name="maintenance_team_id" string="Brigada"/>
                    <field name="execute_cost_center_id" invisible="1"/>
                    <field name="receive_cost_center_id" invisible="1"/>
                    <field name="creator_id" invisible="1"/>
                    <field name="emitter_id" invisible="1"/>
                    <field name="executor_id" invisible="1"/>
                    <field name="shutter_id" invisible="1"/>
            		<field name="state"/>

	            </tree>
	        </field>
	    </record>

		<!-- SEARCH VIEW -->
        <record id="maintenance_turei_work_order_search_view" model="ir.ui.view">
            <field name="name">maintenance_turei_work_order_search_view</field>
            <field name="model">maintenance_turei.work_order</field>
            <field name="arch" type="xml">
            	<search>
                    <field name="code"/>
                    <field name="number"/>
					<field name="number_new" string="Número nuevo"/>
                    <field name="equipament_id"/>
                    <separator/>
                    <filter string="Hoy" name="today" domain="[('opening_date', '&gt;=', datetime.datetime.now().replace(hour=0, minute=0, second=0)),('opening_date', '&lt;=', datetime.datetime.now().replace(hour=23, minute=59, second=59))]" />
                    <filter string="Mes actual" domain="[('opening_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-01'))]" />
                    <filter string="Año actual" name="current_year"
                            domain="[('opening_date', '&gt;=', datetime.datetime.now().strftime('%Y-01-01')),
                                     ('opening_date', '&lt;=', datetime.datetime.now().strftime('%Y-12-31'))]"/>
					<filter string="Planificadas" name="planificadas" domain="['|', ('work_type', '=', 'plan_ciclo'), ('work_type', '=', 'plan_et')]"/>
					<filter string="Imprevistos" name="imprevistos" domain="['|', ('work_type', '=', 'imp-tec'), ('work_type', '=', 'imp_ope')]"/>
                    <separator/>
                    <group expand="0" string="Agrupar por">
                        <filter name="group_by_opening_date" string="Fecha de apertura" context="{'group_by': 'opening_date'}"/>
                        <filter name="group_by_closing_date" string="Fecha de cierre" context="{'group_by': 'closing_date'}"/>
                        <separator/>

                        <filter name="group_by_execute_cost_center" string="Centro de Costo Ejecuta" context="{'group_by': 'execute_cost_center_id'}"/>
                        <filter name="group_by_receive_cost_center" string="Centro de Costo Recibe" context="{'group_by': 'receive_cost_center_id'}"/>
<!--                        <filter name="group_by_type" string="Type" context="{'group_by': 'type_id'}"/>-->
                        <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                        <separator/>
                        <filter name="group_by_creator" string="Creador" context="{'group_by': 'creator_id'}"/>
                        <filter name="group_by_emitter" string="Emite" context="{'group_by': 'emitter_id'}"/>
                        <filter name="group_by_executor" string="Ejecuta" context="{'group_by': 'executor_id'}"/>
                        <filter name="group_by_shutter" string="Cierra" context="{'group_by': 'shutter_id'}"/>
                        <separator/>
						<filter name="group_by_category" string="Taller" context="{'group_by': 'category_id'}"/>
						<filter name="group_by_work_type" string="Tipo de Trabajo" context="{'group_by': 'work_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="maintenance_turei_work_order_action" model="ir.actions.act_window">
	    	<field name="name">Orden de Trabajo</field>
		    <field name="res_model">maintenance_turei.work_order</field>
			<field name="view_type">form</field>
			<field name="view_mode">tree,form</field>
			<field name="context">{'search_default_current_year': 1}</field>
		</record>

        <!-- MENU ITEM -->
        <menuitem name="Orden de Trabajo"
				  id="maintenance_turei_item_work_order"
				  action="maintenance_turei_work_order_action"
				  parent="maintenance_turei_work_order_menu_item"
				  />


    </data>
</odoo>