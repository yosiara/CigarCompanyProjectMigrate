<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <!-- ======================================================================================
		PRODUCT GROUP
		Model: stock_turei.product_group
		=========================================================================================== -->

        <!-- FORM VIEW -->
        <record id="stock_turei_product_group_form_view" model="ir.ui.view">
            <field name="name">stock_turei_product_group_form_view</field>
            <field name="model">stock_turei.product_group</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title" col="8">
                        	<h1><field name="name" col="8" colspan="8"/></h1>
                        </div>

                        <group>
                            <field name="code"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="stock_turei_product_group_tree_view" model="ir.ui.view">
            <field name="name">stock_turei_product_group_tree_view</field>
            <field name="model">stock_turei.product_group</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <!-- ACTION -->
        <record id="stock_turei_product_group_action" model="ir.actions.act_window">
	    	<field name="name">Product Groups</field>
		    <field name="res_model">stock_turei.product_group</field>
			<field name="binding_view_types">form</field>
			<field name="view_mode">tree,form</field>
			<field name="help" type="html">
                <p class="oe_view_nocontent_create">
              	    Click to create a new <b>Product Group</b>...
                </p>
            </field>
		</record>

        <!-- MENU ITEM -->
        <menuitem name="Product Groups"
                  id="stock_turei_product_group_root_menu"
                  action="stock_turei_product_group_action"
                  parent="stock_turei_left_menu"
                  sequence="10"/>
    </data>
</odoo>
