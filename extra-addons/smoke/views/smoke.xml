<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="smoke.list">
      <field name="name">Smoke List</field>
      <field name="model">smoke.smoke</field>
      <field name="arch" type="xml">
        <tree>
          <field name="date"/>
          <field name="concept_id"/>
          <field name="amount"/>
          <field name="order"/>
          <field name="external_concept_id"/>
        </tree>
      </field>
    </record>

    <!--<record model="ir.ui.view" id="smoke.list2">
