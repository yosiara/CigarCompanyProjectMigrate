<odoo>
  <data>
    <!-- explicit list view definition -->

    <record model="ir.ui.view" id="smoke.search">
      <field name="name">Smoke Search</field>
      <field name="model">smoke.smoke</field>
      <field name="arch" type="xml">
        <search>
          <field name="date"/>
          <field name="concept_id"/>
          <field name="order"/>
          <filter string="Salidas" name="external_concept_id" domain="[('external_concept_id', '=', 64)]"/>
          <separator/>
          <filter string="Devoluciones" name="external_concept_id" domain="[('external_concept_id', '=', 53)]"/>
          <group expand="1" string="Group By">
            <filter string="Fecha" name='date' context="{'group_by': 'date'}"/>
            <separator/>
            <filter string="Conceptos" name='concept_id' context="{'group_by': 'concept_id'}"/>
            <separator/>
            <filter string="Orden" name='order' context="{'group_by': 'order'}"/>
          </group>
        </search>
      </field>
    </record>

    <record model="ir.ui.view" id="smoke.list">
      <field name="name">Smoke List</field>
      <field name="model">smoke.smoke</field>
      <field name="arch" type="xml">
        <tree edit="0" create="0" delete="0" duplicate="0" string="Smoke List">
            <field name="date"/>
            <field name="concept_id"/>
            <field name="amount"/>
            <field name="order"/>
        </tree>
      </field>
    </record>

    <!--<record model="ir.ui.view" id="smoke.list2">
      <field name="name">fuma list</field>
      <field name="model">smoke</field>
      <field name="arch" type="xml">
        <form>
          <field name="name"/>
        </form>
      </field>
    </record> -->

    <record id="smoke_action_window" model="ir.actions.act_window">
      <field name="name">Smoke List</field>
      <field name="res_model">smoke.smoke</field>
      <field name="view_mode">tree</field>
    </record>

<!--
    <record model="ir.actions.server" id="fuma.action_server">
      <field name="name">fuma server</field>
      <field name="model_id" ref="model_fuma_fuma"/>
