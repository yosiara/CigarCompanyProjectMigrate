      <field name="code">
        action = {
          "type": "ir.actions.act_window",
          "view_mode": "tree,form",
          "res_model": model._name,
        }
      </field>
    </record>
-->

    <!-- Top menu item -->
    <!-- <menuitem name="Smoke" id="smoke_menu_root"/> -->
    <menuitem name="Smoke" id="smoke_menu_act_root" action="smoke_action_window"/>

    <!-- List Smoke -->
    <!-- <menuitem name="Listado de Cigarrillos" id="smoke.menu_category" parent="smoke.menu_action_root"/> -->

