<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_smoke">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3 class="mb32">Reporte de la Fuma</h3>
                        <table border="1" class="table table-bordered" style="table-layout:auto">
                            <thead>
                                <tr>
                                    <th>Conceptos</th> <th>Cigarros</th> <th>Devoluciones</th> <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="flagCS">
                                    <tr>
                                        <td>Cartas de Solicitud</td>
                                        <td class="text-center"><t t-out="totalSalCS or '-'"/></td>
                                        <td class="text-center"><t t-out="totalDevCS or '-'"/></td>
                                        <td class="text-center"><t t-out="(totalSalCS - totalDevCS) or '-'"/></td>
                                    </tr>
                                </t>
                                <t t-foreach="len(concepts)" t-as="it">
                                    <tr>
                                        <td>
                                            <t t-out="concepts[it].title()"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-out="cantSal[it]"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-out="cantDev[it] or '-'"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-out="cantSal[it] - cantDev[it]"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <footer>
                                <tr>
                                    <th>Total</th>
                                    <th><t t-out="totalSal + totalSalCS"/></th>
                                    <th><t t-out="totalDev + totalDevCS"/></th>
                                    <th><t t-out="(totalSal + totalSalCS) - (totalDev + totalDevCS)"/></th>
                                </tr>
                            </footer>
                        </table>
                    </div>

                    <t t-if="flagCS">
                        <!-- Salto de página -->
                        <div style="page-break-after: always;"></div>

                        <div class="page">
                            <h3 class="mb32">Cartas de Solicitud Detalladas</h3>
                            <table border="1" class="table table-bordered" style="table-layout:auto">
                                <thead>
                                    <tr>
                                        <th>Fecha</th> <th>Descripción</th> <th>Cantidad</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="desgloseCS" t-as="t">
                                        <tr>
                                            <td class="text-center">
                                                <t t-out="t.date"/>
                                            </td>
                                            <td>
                                                <t t-out="t.concept_id.name.title()"/>
                                            </td>
                                            <td class="text-center">
                                                <t t-out="t.amount"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
    </template>
</odoo>
