<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View ict.service View List -->
    <record id="view_ict_service_list" model="ir.ui.view">
        <field name="name">view.ict.service.list</field>
        <field name="model">ict.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View ict.service form -->
    <record id="view_ict_service_form" model="ir.ui.view">
        <field name="name">view.ict.service.form</field>
        <field name="model">ict.service</field>
        <field name="arch" type="xml">
            <form string="ICT Service">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View ict.service search -->
    <record id="view_ict_service_search" model="ir.ui.view">
        <field name="name">view.ict.service.search</field>
        <field name="model">ict.service</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ict.service -->
    <record id="action_ict_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ict.service</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new ICT Service.
            </p>
        </field>
    </record>

    <!-- Menu ict.service -->
    <menuitem id="menu_service_service" name="Services" parent="menu_ict_service" sequence="5" action="action_ict_service"/>

    <!-- survey.survey -->
    <record id="survey.action_survey_form" model="ir.actions.act_window">
        <field name="domain">[('create_uid', '=', uid)]</field>
        <!-- <field name="context">[('search_default_user_id', '=', uid)]</field> -->
    </record>

    <menuitem id="menu_service_surveys" name="Surveys" parent="menu_ict_service" sequence="10" action="survey.action_survey_form"/>

</odoo>