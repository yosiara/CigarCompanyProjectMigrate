<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <!-- Lista -->
    <record id="view_ict_phone_extension_list" model="ir.ui.view">
        <field name="name">ict.phone.extension.list</field>
        <field name="model">ict.phone.extension</field>
        <field name="arch" type="xml">
            <list>
                <field name="number"/>
                <field name="department_id" invisible="assign_to == 'employee' or not assign_to"/>
                <field name="employee_id" invisible="assign_to == 'department' or not assign_to"/>
                <field name="extension_type"/>
                <field name="assign_date"/>
            </list>
        </field>
    </record>
    
    <!-- Formulario -->
    <record id="view_ict_phone_extension_form" model="ir.ui.view">
        <field name="name">ict.phone.extension.form</field>
        <field name="model">ict.phone.extension</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for='display_name'/>
                        <h1>
                            <field name="display_name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="number"/>
                            <field name="extension_type"/>
                            <field name="assign_to" widget="radio"/>
                        </group>
                        <group>
                            <field name="assign_date" widget="date"/>
                            <field name="department_id" invisible="assign_to == 'employee' or not assign_to"/>
                            <field name="employee_id" invisible="assign_to == 'department' or not assign_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Acción y menú -->
    <record id="action_ict_phone_extension" model="ir.actions.act_window">
        <field name="name">Extensions</field>
        <field name="res_model">ict.phone.extension</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples. Click here to add new ICT Phone Extension.
            </p>
        </field>
    </record>
    
    <menuitem id="menu_phone_extension" name="Extensions" parent="menu_ict_phone" sequence="10" action="action_ict_phone_extension"/>
    
</odoo>