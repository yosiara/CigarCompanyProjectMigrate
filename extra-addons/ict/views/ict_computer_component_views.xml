        <!-- Action ict.computer.component -->
        <record id="action_ict_computer_component" model="ir.actions.act_window">
            <field name="name">Computer Components</field>
            <field name="res_model">ict.computer.component</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    There is no examples click here to add new ICT Computer Components.
                </p>
            </field>
        </record>

        <!-- Menu ict.computer.component -->
        <menuitem id="menu_computer_component"
                name="Computer Components"
                parent="menu_ict_configuration"
                sequence="5"
                action="action_ict_computer_component"/>
    </data>
</odoo>
