<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ict_computer_kanban" model="ir.ui.view">
        <field name="name">ict.computer.kanban</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <kanban js_class="computer_kanban">
                <field name="name"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="pc_type"/>
                <field name="state"/>
                <field name="responsible_name"/>
                <field name="processor_name"/>
                <field name="ip_address"/>
                <field name="purchase_date"/>
                <field name="operating_system"/>
                <field name="total_memory_gb"/>
                <field name="total_storage_gb"/>
                
                <templates>
                    <t t-name="card">
                        <div class="ict-kanban-card">
                            <!-- Barra superior según estado -->
                            <div t-att-class="'status-bar status-' + record.state.raw_value"></div>
                            
                            <!-- Badge de estado -->
                            <div t-att-class="'status-badge badge-' + record.state.raw_value">
                                <span>
                                    <i t-attf-class="fa {{
                                        record.state.raw_value === 'new' ? 'fa-star' :
                                        record.state.raw_value === 'in_use' ? 'fa-play-circle' :
                                        record.state.raw_value === 'repair' ? 'fa-wrench' : 'fa-archive'
                                    }}"></i>
                                    <t t-esc="record.state.raw_value.replace('_', ' ').toUpperCase()"/>
                                </span>
                            </div>
                            
                            <div class="card-body">
                                <!-- Icono principal -->
                                <div class="icon-wrapper">
                                    <div t-att-class="'icon-circle icon-' + record.pc_type.raw_value">
                                        <i t-attf-class="fa {{
                                            record.pc_type.raw_value === 'laptop' ? 'fa-laptop' :
                                            record.pc_type.raw_value === 'desktop' ? 'fa-desktop' : 'fa-server'
                                        }}"></i>
                                    </div>
                                </div>
                                
                                <!-- Información del equipo -->
                                <div class="computer-info">
                                    <h3><field name="name"/></h3>
                                    <div class="model">
                                        <field name="brand"/> <field name="model"/>
                                    </div>
                                </div>
                                
                                <!-- Especificaciones -->
                                <div class="specs">
                                    <span class="spec" t-att-title="'Procesador: ' + record.processor_name.raw_value or 'N/A'">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cpu" viewBox="0 0 16 16">
                                            <path d="M5 0a.5.5 0 0 1 .5.5V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2A2.5 2.5 0 0 1 14 4.5h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14a2.5 2.5 0 0 1-2.5 2.5v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14A2.5 2.5 0 0 1 2 11.5H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2A2.5 2.5 0 0 1 4.5 2V.5A.5.5 0 0 1 5 0m-.5 3A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 11.5 3zM5 6.5A1.5 1.5 0 0 1 6.5 5h3A1.5 1.5 0 0 1 11 6.5v3A1.5 1.5 0 0 1 9.5 11h-3A1.5 1.5 0 0 1 5 9.5zM6.5 6a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5z"/>
                                        </svg>
                                        <!-- <i class="fa fa-microchip"></i> -->
                                        <t t-esc="record.processor_name.raw_value or 'N/A'"/>
                                    </span>

                                    <span class="spec" t-att-title="'Total Memoria RAM: ' + (record.total_memory_gb.raw_value or '?') + 'GB'">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-memory" viewBox="0 0 16 16">
                                            <path d="M1 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.586a1 1 0 0 0 .707-.293l.353-.353a.5.5 0 0 1 .708 0l.353.353a1 1 0 0 0 .707.293H15a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zm.5 1h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5m5 0h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5m4.5.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5zM2 10v2H1v-2zm2 0v2H3v-2zm2 0v2H5v-2zm3 0v2H8v-2zm2 0v2h-1v-2zm2 0v2h-1v-2zm2 0v2h-1v-2z"/>
                                        </svg>
                                        <t t-esc="record.total_memory_gb.raw_value or '?'"/>GB
                                    </span>

                                    <span class="spec" t-att-title="'Total Almacenamiento: ' + (record.total_storage_gb.raw_value or '?') + 'GB'">
                                        <i class="fa fa-hdd-o"></i>
                                        <t t-esc="record.total_storage_gb.raw_value or '?'"/>GB
                                    </span>
                                </div>
                                
                                <!-- Asignación -->
                                <div t-if="record.responsible_name.raw_value" class="assignment">
                                    <div class="assignment-content">
                                        <div class="avatar">
                                            <span t-esc="record.responsible_name.raw_value.charAt(0).toUpperCase()"/>
                                        </div>
                                        <div class="assignment-info">
                                            <small>Asignado a</small>
                                            <span class="employee-name" t-esc="record.responsible_name.raw_value"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card-footer">
                                <span class="footer-item" t-att-title="'Sistema Operativo: ' + (record.operating_system.raw_value ? record.operating_system.raw_value.replace('_', ' ').toUpperCase() : 'Sin instalar')" t-att-class="record.operating_system.raw_value ? 'text-warning' : 'text-muted'">
                                    <t t-if="record.operating_system.raw_value == 'linux'">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-tux" viewBox="0 0 16 16">
                                            <path d="M8.996 4.497c.104-.076.1-.168.186-.158s.022.102-.098.207c-.12.104-.308.243-.46.323-.291.152-.631.336-.993.336s-.647-.167-.853-.33c-.102-.082-.186-.162-.248-.221-.11-.086-.096-.207-.052-.204.075.01.087.109.134.153.064.06.144.137.241.214.195.154.454.304.778.304s.702-.19.932-.32c.13-.073.297-.204.433-.304M7.34 3.781c.055-.02.123-.031.174-.003.011.006.024.021.02.034-.012.038-.074.032-.11.05-.032.017-.057.052-.093.054-.034 0-.086-.012-.09-.046-.007-.044.058-.072.1-.089m.581-.003c.05-.028.119-.018.173.003.041.017.106.045.1.09-.004.033-.057.046-.09.045-.036-.002-.062-.037-.093-.053-.036-.019-.098-.013-.11-.051-.004-.013.008-.028.02-.034"/>
