<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ict_computer_kanban" model="ir.ui.view">
        <field name="name">ict.computer.kanban</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <kanban js_class="computer_kanban">
                <field name="name"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="type"/>
                <field name="state"/>
                <field name="employee_id"/>
                <field name="employee_name"/>
                <field name="processor"/>
                <field name="ram_gb"/>
                <field name="storage_gb"/>
                <field name="storage_type"/>
                <field name="ip_address"/>
                <field name="purchase_date"/>
                <field name="department_name"/>
                
                <templates>
                    <t t-name="card">
                        <div class="ict-kanban-card">
                            <!-- Barra superior según estado -->
                            <div t-att-class="'status-bar status-' + record.state.raw_value"></div>
                            
                            <!-- Badge de estado -->
                            <div t-att-class="'status-badge badge-' + record.state.raw_value">
                                <span>
                                    <i t-attf-class="fa {{
                                        record.state.raw_value === 'new' ? 'fa-star' :
                                        record.state.raw_value === 'in_use' ? 'fa-play-circle' :
                                        record.state.raw_value === 'repair' ? 'fa-wrench' : 'fa-archive'
                                    }}"></i>
                                    <t t-esc="record.state.raw_value.replace('_', ' ').toUpperCase()"/>
                                </span>
                            </div>
                            
                            <div class="card-body">
                                <!-- Icono principal -->
                                <div class="icon-wrapper">
                                    <div t-att-class="'icon-circle icon-' + record.type.raw_value">
                                        <i t-attf-class="fa {{
                                            record.type.raw_value === 'laptop' ? 'fa-laptop' :
                                            record.type.raw_value === 'desktop' ? 'fa-desktop' : 'fa-server'
                                        }}"></i>
                                    </div>
                                </div>
                                
                                <!-- Información del equipo -->
                                <div class="computer-info">
                                    <h3><field name="name"/></h3>
                                    <div class="model">
                                        <field name="brand"/> <field name="model"/>
                                    </div>
                                </div>
                                
                                <!-- Especificaciones -->
                                <div class="specs">
                                    <span class="spec">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cpu" viewBox="0 0 16 16">
                                            <path d="M5 0a.5.5 0 0 1 .5.5V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2A2.5 2.5 0 0 1 14 4.5h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14a2.5 2.5 0 0 1-2.5 2.5v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14A2.5 2.5 0 0 1 2 11.5H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2A2.5 2.5 0 0 1 4.5 2V.5A.5.5 0 0 1 5 0m-.5 3A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 11.5 3zM5 6.5A1.5 1.5 0 0 1 6.5 5h3A1.5 1.5 0 0 1 11 6.5v3A1.5 1.5 0 0 1 9.5 11h-3A1.5 1.5 0 0 1 5 9.5zM6.5 6a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5z"/>
                                        </svg>
                                        <!-- <i class="fa fa-microchip"></i> -->
                                        <t t-esc="record.processor.raw_value or 'N/A'"/>
                                    </span>
                                    <span class="spec">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-memory" viewBox="0 0 16 16">
                                            <path d="M1 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.586a1 1 0 0 0 .707-.293l.353-.353a.5.5 0 0 1 .708 0l.353.353a1 1 0 0 0 .707.293H15a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zm.5 1h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5m5 0h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5m4.5.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5zM2 10v2H1v-2zm2 0v2H3v-2zm2 0v2H5v-2zm3 0v2H8v-2zm2 0v2h-1v-2zm2 0v2h-1v-2zm2 0v2h-1v-2z"/>
                                        </svg>
                                        <t t-esc="record.ram_gb.raw_value or '?'"/>GB
                                    </span>
                                    <span class="spec">
                                        <!-- <t t-if="record.debit.raw_value > 0">
                                            <field name="debit"/><span> (DR)</span>
                                        </t> -->
                                        <i t-if="record.storage_type.raw_value == 'nvme'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-nvme" viewBox="0 0 16 16">
                                                <path d="M1.5 4.5A.5.5 0 0 1 2 4h13.5a.5.5 0 0 1 .5.5V7a.5.5 0 0 1-.5.5.5.5 0 0 0 0 1 .5.5 0 0 1 .5.5v2.5a.5.5 0 0 1-.5.5H2a.5.5 0 0 1-.5-.5h-1A.5.5 0 0 1 0 11V7.5A.5.5 0 0 1 .5 7h1a.25.25 0 0 0 0-.5h-1A.5.5 0 0 1 0 6V5a.5.5 0 0 1 .5-.5zm1 .5a.5.5 0 0 1-.5.5h-.5a1.25 1.25 0 1 1 0 2.5H1v2.5h1a.5.5 0 0 1 .5.5H15V9.415a1.5 1.5 0 0 1 0-2.83V5z"/>
                                                <path d="M4 6.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1-.5-.5zM5 7v2h1V7zm3-.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5h-4a.5.5 0 0 1-.5-.5zM9 7v2h3V7z"/>
                                            </svg>
                                        </i>
                                        <i t-elif="record.storage_type.raw_value == 'ssd'">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-device-ssd" viewBox="0 0 16 16">
                                                <path d="M4.75 4a.75.75 0 0 0-.75.75v3.5c0 .414.336.75.75.75h6.5a.75.75 0 0 0 .75-.75v-3.5a.75.75 0 0 0-.75-.75zM5 8V5h6v3zm0-5.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m7 0a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0M4.5 11a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1m7 0a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1"/>
                                                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm11 12V2a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1v-2a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2a1 1 0 0 0 1-1m-7.25 1v-2H5v2zm1.75 0v-2h-.75v2zm1.75 0v-2H8.5v2zM11 13h-.75v2H11z"/>
                                            </svg>
                                        </i>
                                        <i t-else="">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-device-hdd" viewBox="0 0 16 16">
                                                <path d="M12 2.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m0 11a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0m-7.5.5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1M5 2.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0M8 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2"/>
                                                <path d="M12 7a4 4 0 0 1-3.937 4c-.537.813-1.02 1.515-1.181 1.677a1.102 1.102 0 0 1-1.56-1.559c.1-.098.396-.314.795-.588A4 4 0 0 1 8 3a4 4 0 0 1 4 4m-1 0a3 3 0 1 0-3.891 2.865c.667-.44 1.396-.91 1.955-1.268.224-.144.483.115.34.34l-.62.96A3 3 0 0 0 11 7"/>
                                                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/>
                                            </svg>
                                        </i>
                                        <t t-esc="record.storage_gb.raw_value or '?'"/>GB
                                    </span>
                                </div>
                                
                                <!-- Asignación -->
                                <div t-if="record.employee_id.raw_value" class="assignment">
                                    <div class="assignment-content">
                                        <div class="avatar">
                                            <span t-esc="record.employee_name.raw_value.charAt(0).toUpperCase()"/>
                                        </div>
                                        <div class="assignment-info">
                                            <small>Asignado a</small>
                                            <span class="employee-name" t-esc="record.employee_name.raw_value"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Footer con acciones -->
                            <!-- <div class="card-footer">
                                <button class="btn-view">
                                    <i class="fa fa-eye"/> Ver
                                </button>
                                <button class="btn-edit">
                                    <i class="fa fa-edit"/> Editar
                                </button>
                                <button class="btn-maintenance">
                                    <i class="fa fa-cog"/> Mant.
                                </button>
                            </div> -->
                            
                            <div class="card-footer flex-row justify-content-between">
                                <span class="footer-item" t-att-title="'IP: ' + (record.ip_address.raw_value or 'No asignada')">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" fill="currentColor" class="bi bi-ethernet" t-att-class="record.ip_address.raw_value ? 'text-primary' : 'text-muted'" viewBox="0 0 16 16">
                                        <path d="M14 13.5v-7a.5.5 0 0 0-.5-.5H12V4.5a.5.5 0 0 0-.5-.5h-1v-.5A.5.5 0 0 0 10 3H6a.5.5 0 0 0-.5.5V4h-1a.5.5 0 0 0-.5.5V6H2.5a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5M3.75 11h.5a.25.25 0 0 1 .25.25v1.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25v-1.5a.25.25 0 0 1 .25-.25m2 0h.5a.25.25 0 0 1 .25.25v1.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25v-1.5a.25.25 0 0 1 .25-.25m1.75.25a.25.25 0 0 1 .25-.25h.5a.25.25 0 0 1 .25.25v1.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25zM9.75 11h.5a.25.25 0 0 1 .25.25v1.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25v-1.5a.25.25 0 0 1 .25-.25m1.75.25a.25.25 0 0 1 .25-.25h.5a.25.25 0 0 1 .25.25v1.5a.25.25 0 0 1-.25.25h-.5a.25.25 0 0 1-.25-.25z"/>
                                        <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 2a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/>
                                    </svg>
                                    <!-- <i class="fa fa-network-wired" t-att-class="record.ip_address.raw_value ? 'text-primary' : 'text-muted'"></i> -->
                                    <t t-esc="record.ip_address.raw_value or '—'"/>
                                </span>
                                
                                <span class="footer-item" t-att-title="'Compra: ' + (record.purchase_date.raw_value or 'Sin fecha')">
                                    <i class="fa fa-calendar" t-att-class="record.purchase_date.raw_value ? 'text-success' : 'text-muted'"></i>
                                    <t t-esc="record.purchase_date.raw_value.split('T')[0] or '—'"/>
                                </span>
                                
                                <!-- <span class="footer-item" t-att-title="'Depto: ' + (record.department_name.raw_value ? record.department_name.raw_value : 'Sin asignar')">
                                    <i class="fa fa-building" t-att-class="record.department_name.raw_value ? 'text-warning' : 'text-muted'"></i>
                                    <t t-esc="record.department_name.raw_value ? record.department_name.raw_value : '—'"/>
                                </span> -->
                            </div>
                            
                            <!-- Efecto de brillo -->
                            <div class="shine-effect"></div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View ict.computer View List -->
    <record id="view_ict_computer_list" model="ir.ui.view">
        <field name="name">ict.computer.list</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="employee_id"/>
                <field name="state"/>
                <field name="purchase_date"/>
                <field name="processor"/>
                <field name="ram_gb"/>
                <field name="storage_gb"/>
                <field name="storage_type"/>
                <field name="ip_address"/>
                <field name="mac_address"/>
                <field name="department_id"/>
                <field name="active"/>
                <field name="warranty_date"/>
                <field name="supplier"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- View ict.computer form -->
    <record id="view_ict_computer_form" model="ir.ui.view">
        <field name="name">view.ict.computer.form</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <form string="ICT Computer">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <field name="type"/>
                    <field name="brand"/>
                    <field name="model"/>
                    <field name="employee_id"/>
                    <field name="state"/>
                    <field name="purchase_date"/>
                    <field name="processor"/>
                    <field name="ram_gb"/>
                    <field name="storage_gb"/>
                    <field name="storage_type"/>
                    <field name="ip_address"/>
                    <field name="mac_address"/>
                    <field name="department_id"/>
                    <field name="active"/>
                    <field name="warranty_date"/>
                    <field name="supplier"/>
                    <field name="notes"/>

                </sheet>
            </form>
        </field>
    </record>

    <!-- View ict.computer search -->
    <record id="view_ict_computer_search" model="ir.ui.view">
        <field name="name">view.ict.computer.search</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ict.computer -->
    <record id="action_ict_computer" model="ir.actions.act_window">
        <field name="name">Computers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ict.computer</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new It Computer.
            </p>
        </field>
    </record>

    <!-- Menu ict.computer -->
    <menuitem id="menu_computers" 
              name="Computers" 
              parent="menu_ict_root" 
              sequence="20"
              action="action_ict_computer"/>

</odoo>