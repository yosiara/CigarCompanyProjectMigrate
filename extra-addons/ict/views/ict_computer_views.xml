                                        <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zM1 2a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z"/>
                                    </svg>
                                    <!-- <i class="fa fa-network-wired" t-att-class="record.ip_address.raw_value ? 'text-primary' : 'text-muted'"></i> -->
                                    <t t-esc="record.ip_address.raw_value or '—'"/>
                                </span>
                                
                                <span class="footer-item" t-att-title="'Fecha de Compra: ' + (record.purchase_date.raw_value or 'Sin fecha')" t-att-class="record.purchase_date.raw_value ? 'text-success' : 'text-muted'">
                                    <i class="fa fa-calendar"></i>
                                    <t t-esc="record.purchase_date.raw_value ? record.purchase_date.raw_value.split('T')[0] : '-'"/>
                                </span>
                                
                                <!-- <span class="footer-item" t-att-title="'Depto: ' + (record.department_name.raw_value ? record.department_name.raw_value : 'Sin asignar')">
                                    <i class="fa fa-building" t-att-class="record.department_name.raw_value ? 'text-warning' : 'text-muted'"></i>
                                    <t t-esc="record.department_name.raw_value ? record.department_name.raw_value : '—'"/>
                                </span> -->
                            </div>
                            
                            <!-- Efecto de brillo -->
                            <div class="shine-effect"></div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View ict.computer List -->
    <record id="view_ict_computer_list" model="ir.ui.view">
        <field name="name">ict.computer.list</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pc_type"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="state"/>
                <field name="purchase_date"/>
                <field name="ip_address"/>
                <!-- <field name="mac_address"/> -->
                <!-- <field name="department_id"/> -->
                <field name="active"/>
                <field name="warranty_date"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <!-- View ict.computer Form -->
    <record id="view_ict_computer_form" model="ir.ui.view">
        <field name="name">ict.computer.form</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <form string="Computer">
                <header>
                    <button name="action_start_using" type="object" class="btn-primary" string="Start Using"/>
                    <button name="action_send_repair" type="object" class="btn-warning" string="Send to Repair"/>
                    <button name="action_retire" type="object" class="btn-danger" string="Retire"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_use,repair,retired" options="{'clickable': '1'}"/>
                </header>
                <sheet class="computer_form_sheet">
                    <field name="company_id" invisible="1"/>
                    <field name="maintenance_team_id" context="{'default_company_id':company_id}" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(maintenance.hr_equipment_request_action_from_equipment)d"
                            type="action"
                            class="oe_stat_button"
                            context="{'search_default_active': True, 'default_company_id': company_id, 'default_maintenance_team_id': maintenance_team_id}"
                            icon="fa-wrench">
                            <field string="Maintenance" name="maintenance_open_count" widget="statinfo"/>
                        </button>
                    </div>

                    <!-- Tarjeta resumen mejorada -->
                    <div class="computer_hero">
                        <div class="hero_icon" t-attf-class="hero_{{pc_type}}">
                            <i class="fa fa-laptop"  invisible="pc_type != 'laptop'"/>
                            <i class="fa fa-desktop" invisible="pc_type != 'desktop'"/>
                            <i class="fa fa-server"  invisible="pc_type != 'server'"/>
                        </div>
                        <div class="hero_info">
                            <h1><field name="name" placeholder="Computer name..."/></h1>
                            <div class="hero_details">
                                <span class="brand_model"><field name="brand"/> <field name="model"/></span>
                                <span class="separator">•</span>
                                <span class="inventory"><i class="fa fa-tag"/> <field name="inventory_number" placeholder="Inventory #"/></span>
                            </div>
                        </div>
                        <div class="hero_specs">
                            <div class="hero_spec">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cpu" viewBox="0 0 16 16">
                                    <path d="M5 0a.5.5 0 0 1 .5.5V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2h1V.5a.5.5 0 0 1 1 0V2A2.5 2.5 0 0 1 14 4.5h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14v1h1.5a.5.5 0 0 1 0 1H14a2.5 2.5 0 0 1-2.5 2.5v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14h-1v1.5a.5.5 0 0 1-1 0V14A2.5 2.5 0 0 1 2 11.5H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2v-1H.5a.5.5 0 0 1 0-1H2A2.5 2.5 0 0 1 4.5 2V.5A.5.5 0 0 1 5 0m-.5 3A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 11.5 3zM5 6.5A1.5 1.5 0 0 1 6.5 5h3A1.5 1.5 0 0 1 11 6.5v3A1.5 1.5 0 0 1 9.5 11h-3A1.5 1.5 0 0 1 5 9.5zM6.5 6a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5z"/>
                                </svg>
                                <span><field name="processor_name" widget="badge"/></span>
                            </div>
                            <div class="hero_spec">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-memory" viewBox="0 0 16 16">
                                    <path d="M1 3a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4.586a1 1 0 0 0 .707-.293l.353-.353a.5.5 0 0 1 .708 0l.353.353a1 1 0 0 0 .707.293H15a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zm.5 1h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5m5 0h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-4a.5.5 0 0 1 .5-.5m4.5.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5zM2 10v2H1v-2zm2 0v2H3v-2zm2 0v2H5v-2zm3 0v2H8v-2zm2 0v2h-1v-2zm2 0v2h-1v-2zm2 0v2h-1v-2z"/>
                                </svg>
                                <span><field name="total_memory_gb"/> GB RAMs</span>
                            </div>
                            <div class="hero_spec">
                                <i class="fa fa-hdd-o"></i>
                                <span><field name="total_storage_gb"/> GB Disks</span>
                            </div>

                            <div class="hero_spec" invisible="not operating_system">
                                <!-- <i class="fa fa-windows" t-if="operating_system == 'windows_10' or operating_system == 'windows_11'"></i>
                                <i class="fa fa-linux" t-if="operating_system == 'linux'"></i>
                                <i class="fa fa-apple" t-if="operating_system == 'macos'"></i> -->
                                <i class="fa fa-linux" invisible="operating_system == 'windows_10' or operating_system == 'macos'"/>
                                <i class="fa fa-apple" invisible="operating_system == 'linux' or operating_system == 'windows_10'"/>
                                <i class="fa fa-windows" invisible="operating_system == 'linux' or operating_system == 'macos'"/>                                
                                <span><field name="operating_system"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- Pestañas organizadas -->
                    <notebook class="computer_notebook">
                        <!-- Pestaña 1: Información general -->
                        <page string="General Information">
                            <group>
                                <group string="Hardware Configuration">
                                    <field name="pc_type"/>
                                    <field name="brand" required="1"/>
                                    <field name="model"/>
                                    <field name="processor_name" readonly="1" class="oe_inline"/>
                                    <field name="total_memory_gb" readonly="1"/>
                                    <field name="total_storage_gb" readonly="1"/>
                                </group>
                                <group string="Software &amp; Network">
                                    <field name="operating_system"/>
                                    <field name="os_version"/>
                                    <field name="ip_address" widget="url"/>
                                    <field name="mac_address"/>
                                    <field name="uuid"/>
                                    <field name="domain"/>
                                </group>
                            </group>
                            <group string="Equipment Details &amp; Procurement" name="equipment_fields">
                                <group>
                                    <field name="owner_user_id" options="{'no_create': True}"/>
                                    <field name="category_id" options="{'no_create_edit': True}"/>
                                    <field name="partner_id" placeholder="Vendor"/>
                                    <field name="location"/>
                                    <field name="serial_no"/>
                                </group>
                                <group>
                                    <field name="assign_date" widget="date"/>
                                    <field name="cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="warranty_date" widget="date"/>
                                    <field name="scrap_date" widget="date"/>
                                    <field name="active" invisible="not context.get('show_inactive')"/>
                                </group>
                            </group>
                            <field name="note" placeholder="Additional notes..." nolabel="1"/>
                        </page>

                        <!-- Pestaña 2: Componentes -->
                        <page string="Components" name="components">
                            <field name="component_ids"> <!--context="{'default_computer_id': active_id}"-->
                                <list editable="bottom" string="Hardware Components">
                                    <field name="component_type" widget="badge"/>
                                    <field name="name"/>
                                    <field name="manufacturer"/>
                                    <field name="model"/>
                                    <field name="serial_no"/>
                                    <field name="capacity" string="Capacity (GB)"/>
                                    <field name="disk_size" string="Disk (GB)"/>
                                    <field name="speed" string="Speed"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>

                        <!-- Pestaña 3: Aplicaciones instaladas -->
                        <page string="Applications" name="applications">
                            <field name="application_ids">
                                <list string="Software" editable="bottom">
                                    <field name="name"/>
                                    <field name="version"/>
                                    <field name="publisher"/>
                                    <!-- <field name="install_date"/> -->
                                </list>
                            </field>
                        </page>

                        <!-- Pestaña 4: Solicitudes de mantenimiento (heredadas) -->
                        <page string="Maintenance Requests" name="maintenance">
                            <field name="maintenance_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="user_id"/>
                                    <field name="request_date"/>
                                    <field name="close_date"/>
                                </list>
                            </field>
                        </page>

                        <!-- Pestaña 5: Propiedades dinámicas -->
                        <page string="Properties" name="properties">
                            <field name="equipment_properties"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View ict.computer search -->
    <record id="view_ict_computer_search" model="ir.ui.view">
        <field name="name">view.ict.computer.search</field>
        <field name="model">ict.computer</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ict.computer -->
    <record id="action_ict_computer" model="ir.actions.act_window">
        <field name="name">Computers</field>
        <field name="res_model">ict.computer</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new ICT Computer.
            </p>
        </field>
    </record>

    <!-- Menu ict.computer -->
    <menuitem id="menu_computers" 
              name="Computers" 
              parent="menu_ict_root" 
              sequence="20"
              action="action_ict_computer"/>

