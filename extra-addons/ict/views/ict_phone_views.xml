<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <!-- Lista -->
    <record id="view_ict_phone_list" model="ir.ui.view">
        <field name="name">ict.phone.list</field>
        <field name="model">ict.phone</field>
        <field name="arch" type="xml">
            <list>
                <field name="brand"/>
                <field name="model"/>
                <field name="serial_no"/>
                <field name="physical_condition"/>
                <field name="state"/>
                <field name="phone_type"/>
                <field name="mac_address"/>
                <field name="extension_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    
    <!-- Formulario -->
    <record id="view_ict_phone_form" model="ir.ui.view">
        <field name="name">ict.phone.form</field>
        <field name="model">ict.phone</field>
        <field name="arch" type="xml">
            <form string="Phone">
                <header>
                    <!-- Botones de cambio de estado -->
                    <button name="action_send_repair" type="object"
                            class="btn-warning"
                            string="Send to Repair"
                            invisible="state in ['repair', 'retired']"/>
                    <button name="action_retire" type="object"
                            class="btn-danger"
                            string="Retire"
                            confirm="Are you sure you want to retire this phone?"
                            invisible="state == 'retired'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,assigned,repair,retired"/>
                </header>
                <sheet class="phone_form_sheet">
                    <div class="hero phone_hero">
                        <!-- Icono tipo teléfono -->
                        <div class="hero_icon hero_phone">
                            <i class="fa fa-phone" title="Phone"/>
                        </div>
                        <!-- IMEI/Serial -->
                        <div class="hero_name">
                            <field name="serial_no" placeholder="Serial Number"/>
                        </div>
                        <!-- Especificaciones rápidas -->
                        <div class="hero_specs">
                            <div class="hero_spec">
                                <i class="fa fa-star" title="Assign Date"/>
                                <field name="assign_date" widget="date" readonly="1"/>
                            </div>
                            <div class="hero_spec">
                                <i class="fa fa-money" title="Purchase Date"/>
                                <field name="purchase_date" widget="date"/>
                            </div>
                            <div class="hero_spec">
                                <i class="fa fa-heartbeat" title="Physical condition"/>
                                <field name="physical_condition"/>
                            </div>
                        </div>
                    </div>
                    
                    <group class="o_ict_phone_details">
                        <group class="o_ict_group">
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="phone_type"/>
                            <field name="poe_support" widget="boolean_toggle"/>
                            <field name="extension_ids" options="{'no_create': True}" widget="many2many_tags"/>
                        </group>
                        <group class="o_ict_group">
                            <field name="mac_address"/>
                            <field name="ip_address"/>
                            <field name="network_ports"/>
                            <field name="has_screen" widget="boolean_toggle"/>
                            <field name="employee_ids" options="{'no_create': True}" widget="many2many_tags"/>
                        </group>
                    </group>

                    <!-- Do not remove these fields; they are calculated using compute and onchange methods. -->
                    <group invisible="1">
                        <field name="name"/>
                    </group>

                    <separator string=" "/>
                    
                    <notebook class="notebook phone_notebook">
                        <page string="Notes">
                            <field name="note" placeholder="Additional notes..."/>
                        </page>
                        <!-- <page string="Assignment History">
                            <field name="assignment_history_ids"/>
                        </page> -->
                    </notebook>
                    
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Acción y menú -->
    <record id="action_ict_phone" model="ir.actions.act_window">
        <field name="name">Phones</field>
        <field name="res_model">ict.phone</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples. Click here to add new ICT Phone Extension.
            </p>
        </field>
    </record>
    
    <menuitem id="menu_phone" name="Phones" parent="menu_ict_phone" sequence="5" action="action_ict_phone"/>
    
</odoo>