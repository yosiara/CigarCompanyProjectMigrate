<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View ict.phone View List -->
    <record id="view_ict_phone_list" model="ir.ui.view">
        <field name="name">view.ict.phone.list</field>
        <field name="model">ict.phone</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="phone_number"/>
                <field name="carrier"/>
                <field name="employee_ids"/>
                <field name="data_plan"/>
                <field name="data_gb"/>
                <field name="assignment_date"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- View ict.phone form -->
    <record id="view_ict_phone_form" model="ir.ui.view">
        <field name="name">view.ict.phone.form</field>
        <field name="model">ict.phone</field>
        <field name="arch" type="xml">
            <form string="ICT Phone">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                        <field name="brand"/>
                        <field name="model"/>
                        <field name="phone_number"/>
                        <field name="carrier"/>
                        <field name="employee_ids"/>
                        <field name="data_plan"/>
                        <field name="data_gb"/>
                        <field name="assignment_date"/>
                        <field name="state"/>
                        <field name="active"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- View ict.phone search -->
    <record id="view_ict_phone_search" model="ir.ui.view">
        <field name="name">view.ict.phone.search</field>
        <field name="model">ict.phone</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ict.phone -->
    <record id="action_ict_phone" model="ir.actions.act_window">
        <field name="name">Phones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ict.phone</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new It Phone.
            </p>
        </field>
    </record>

    <menuitem id="menu_phones" 
              name="Phones" 
              parent="menu_ict_root" 
              sequence="30"
              action="action_ict_phone"/>

</odoo>
