<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ict_employee_kanban" model="ir.ui.view">
        <field name="name">ict.employee.kanban</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_employee_ict"> <!-- default_group_by="department_id" -->
                <!-- Campos necesarios para el template -->
                <field name="name"/>
                <field name="job_title"/>
                <field name="hire_date"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="mobile_phone"/>
                <field name="domain_user"/>
                <field name="department_id"/>
                <field name="department_name"/>
                <field name="department_hex_color"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="user_status"/>
                <field name="computer_ids"/>
                <field name="phone_ids"/>
                <field name="whatsapp_url"/>
                <field name="formatted_hire_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card o_kanban_card_employee"
                            t-attf-style="--dept-color: #{record.department_hex_color.raw_value or '#adb5bd'};">
                            <!-- t-attf-style="border-left: 4px solid #{record.department_hex_color.raw_value or '#e0e0e0'};"> -->

                            <!-- ===== CABECERA: presencia + departamento ===== -->
                            <!-- Cabecera: presencia + departamento -->
                            <div class="d-flex justify-content-between p-1 pb-0">
                                <t t-set="im_status" t-value="record.user_id.raw_value and record.user_id.raw_value.im_status or 'offline'"/>
                                <span class="presence_dot" t-att-class="im_status == 'online' ? 'online' : 'offline'"
                                    t-att-title="im_status == 'online' ? 'Conectado' : 'Desconectado'"/>
                                <span t-if="record.department_name.raw_value"
                                    class="badge rounded-pill"
                                    t-attf-style="background-color: #{record.department_hex_color.value or '#adb5bd'}20; color: {record.department_hex_color.value or '#555'};">
                                    <t t-esc="record.department_name.value"/>
                                </span>
                            </div>

                            <!-- Avatar + Nombre + Cargo + Fecha -->
                            <div class="text-center px-2 pt-1 pb-1">
                                <t t-set="emp_id" t-value="record.employee_id.raw_value"/>
                                <img t-if="emp_id"
                                    t-att-src="kanban_image('hr.employee', 'image_1920', emp_id)"
                                    class="rounded-circle mb-1"
                                    style="width:80px; height:80px; border: 3px solid white; box-shadow: 0 2px 8px rgba(0,0,0,0.1); object-fit: cover;"/>
                                <h5 class="mb-0 employee-name"><t t-esc="record.name.value"/></h5>
                                <small class="text-muted">
                                    <t t-esc="record.job_title.value or ''"/>
                                    <t t-if="record.job_title.value and record.formatted_hire_date.value"> · </t>
                                    <t t-esc="record.formatted_hire_date.value ? 'Desde: ' + record.formatted_hire_date.value : ''"/>
                                </small>
                            </div>

                            <!-- Contacto + usuario + dispositivos todo en líneas compactas -->
                            <div class="px-2 small">
                                <!-- Línea 1: Email y teléfonos -->
                                <div t-if="record.work_email.value or record.work_phone.value or record.mobile_phone.value"
                                    class="d-flex align-items-center contact-line text-muted">
                                    <i class="fa fa-envelope-o me-1" t-if="record.work_email.value"/>
                                    <t t-if="record.work_email.value"><t t-esc="record.work_email.value"/></t>
                                    <t t-if="record.work_email.value and (record.work_phone.value or record.mobile_phone.value)"> · </t>
                                    <i class="fa fa-phone me-1" t-if="record.work_phone.value or record.mobile_phone.value"/>
                                    <t t-if="record.work_phone.value"><t t-esc="record.work_phone.value"/></t>
                                    <t t-if="record.work_phone.value and record.mobile_phone.value"> · </t>
                                    <t t-if="record.mobile_phone.value"><t t-esc="record.mobile_phone.value"/></t>
                                </div>
                                <!-- Línea 2: Usuario + resumen de dispositivos -->
                                <div t-if="record.domain_user.value or computers or phones"
                                    class="d-flex align-items-center contact-line text-muted">
                                    <i class="fa fa-terminal me-1" t-if="record.domain_user.value"/>
                                    <t t-if="record.domain_user.value"><t t-esc="record.domain_user.value"/></t>
                                    <t t-if="record.domain_user.value and (computers or phones)"> · </t>
                                    <i class="fa fa-desktop me-1" t-if="computers"/>
                                    <t t-if="computers"><t t-esc="len(computers)"/> equipos</t>
                                    <t t-if="computers and phones"> · </t>
                                    <i class="fa fa-mobile-phone me-1" t-if="phones"/>
                                    <t t-if="phones"><t t-esc="len(phones)"/> teléfonos</t>
                                </div>
                            </div>

                            <!-- Footer: acciones -->
                            <div class="kanban-footer border-top mt-1 pt-1 pb-1 px-2 d-flex justify-content-around align-items-center">
                                <!-- Email -->
                                <a t-if="record.work_email.value"
                                type="object"
                                name="action_send_email"
                                class="btn btn-sm btn-link footer-action"
                                title="Enviar correo">
                                    <i class="fa fa-envelope-o"/>
                                </a>
                                <!-- Nota interna -->
                                <a t-if="record.user_id.raw_value"
                                type="object"
                                name="action_post_note"
                                class="btn btn-sm btn-link footer-action"
                                title="Añadir nota interna">
                                    <i class="fa fa-comment-o"/>
                                </a>
                                <!-- WhatsApp -->
                                <a t-if="record.whatsapp_url.value"
                                t-att-href="record.whatsapp_url.value"
                                target="_blank"
                                class="btn btn-sm btn-link footer-action"
                                onclick="event.stopPropagation()"
                                title="WhatsApp">
                                    <i class="fa fa-whatsapp"/>
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View ict.employee list -->
    <record id="view_ict_employee_list" model="ir.ui.view">
        <field name="name">view.ict.employee.list</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="domain_user"/>
                <field name="work_email" widget="email"/>
                <field name="work_phone"/>
                <field name="mobile_phone" widget="phone"/>
                <field name="job_title"/>
                <field name="department_name"/>
                <field name="hire_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- View ict.employee form -->
    <record id="view_ict_employee_form" model="ir.ui.view">
        <field name="name">ict.employee.form</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"  placeholder="Pepe Antonio Vargas"/>
                            <field name="domain_user"  placeholder="pepe"/>
                            <field name="domain_id"    placeholder="turei.co.cu"/>
                            <field name="work_phone"   placeholder="222"/>
                            <field name="mobile_phone" placeholder="+53 55555555"/>
                        </group>
                        <group>
                            <field name="job_title"/>
                            <field name="department_name"/>
                            <field name="work_email"/>
                            <field name="hire_date"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <!-- Equipment Assignments -->
                    <group name="assignments">
                        <group string="Assigned Computers">
                            <field name="computer_ids" widget="many2many_tags" row="2"/>
                        </group>
                        <group string="Assigned Phones">
                            <field name="phone_ids" widget="many2many_tags" row="2"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- View ict.employee search -->
    <record id="view_ict_employee_search" model="ir.ui.view">
        <field name="name">view.ict.employee.search</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="domain_user"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="mobile_phone"/>
                <field name="job_title"/>
                <field name="department_name"/>
                <field name="hire_date"/>

                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>

                <group expand="1" string="Group By">
                    <filter string="Job" name="job_title" domain="[]" context="{'group_by':'job_title'}"/>
                    <filter string="Department" name="department_name" domain="[]" context="{'group_by':'department_name'}"/>
                    <filter string="Hire Date" name="hire_date" domain="[]" context="{'group_by':'hire_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ict.employee -->
    <record id="action_ict_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ict.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_active': True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new ICT Employee.
            </p>
        </field>
    </record>

    <!-- Menu ict.employee -->
    <menuitem id="menu_employees" name="Employees" parent="menu_ict_root" sequence="10" action="ict.action_ict_employee"/>

</odoo>
