<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <!-- Lista -->
    <record id="view_ict_phone_extension_list" model="ir.ui.view">
        <field name="name">ict.phone.extension.list</field>
        <field name="model">ict.phone.extension</field>
        <field name="arch" type="xml">
            <list>
                <field name="assign_to"/>
                <field name="job_id" invisible="assign_to == 'department' or not assign_to"/>
                <field name="department_id" invisible="assign_to == 'job' or not assign_to"/>
                <field name="phone_id"/>
                <field name="employee_ids" options="{'no_create': True}" widget="many2many_tags"/>
                <field name="calls_code"/>
                <field name="calls_cap_plan"/>
            </list>
        </field>
    </record>
    
    <!-- Formulario -->
    <record id="view_ict_phone_extension_form" model="ir.ui.view">
        <field name="name">ict.phone.extension.form</field>
        <field name="model">ict.phone.extension</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_suspend" type="object"
                            class="btn-warning"
                            string="Suspend"
                            invisible="state in ['suspended','cancelled']"/>
                    <button name="action_activate" type="object"
                            class="btn-success"
                            string="Activate"
                            invisible="state != 'suspended'"/>
                    <button name="action_cancel" type="object"
                            class="btn-danger"
                            string="Cancel"
                            confirm="Are you sure you want to cancel this line?"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,assigned,suspended,cancelled"/>
                </header>
                <sheet class="phone_extension_form_sheet">
                    <!-- Hero -->
                    <div class="hero phone_extension_hero">
                        <div class="hero_icon hero_phone_extension">
                            <i class="fa fa-mobile" title="mobile Line"/>
                        </div>
                        <div class="hero_name">
                            <field name="number" placeholder="+53 XXXXXXXX"/>
                        </div>
                        <div class="hero_specs">
                            <span class="hero_spec" title="Date of last status">
                                 <i class="fa fa-star"/>
                                <field name="state_date" widget="date"/>
                            </span>
                            <span class="hero_spec" title="Contracted call limit plan">
                                 <i class="fa fa-warning"/>
                                <field name="calls_cap_plan"/>
                            </span>
                            <span class="hero_spec" title="Telecommunications company">
                                <i class="fa fa-signal"/>
                                <field name="carrier"/>
                            </span>
                        </div>
                    </div>

                    <group class="o_ict_phone_extension_details">
                        <group string="Assignment &amp; Security" class="o_ict_group">
                            <field name="assign_to"/>
                            <field name="job_id" invisible="assign_to == 'department' or not assign_to"/>
                            <field name="department_id" invisible="assign_to == 'job' or not assign_to"/>
                            <field name="phone_id"/>
                        </group>
                        <group string="Plan &amp; Services" class="o_ict_group">
                            <field name="employee_ids" options="{'no_create': True}" widget="many2many_tags"/>
                            <field name="calls_code"/>
                            <field name="calls_cap_plan"/>
                        </group>
                    </group>
                    
                    <group class="o_ict_phone_extension_details">
                        <group name="notes" string="Additional service notes" class="o_ict_group">
                            <field name="notes" placeholder="Additional service notes..." nolabel="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Acción y menú -->
    <record id="action_ict_phone_extension" model="ir.actions.act_window">
        <field name="name">Phone Extensions</field>
        <field name="res_model">ict.phone.extension</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples. Click here to add new ICT Phone Extension.
            </p>
        </field>
    </record>
    
    <menuitem id="menu_phone_extension" name="Phone Extensions" parent="menu_ict_phone" sequence="10" action="action_ict_phone_extension"/>
    
</odoo>