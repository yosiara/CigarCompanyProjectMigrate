<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="view_ict_mobile_line_list" model="ir.ui.view">
        <field name="name">ict.mobile.line.list</field>
        <field name="model">ict.mobile.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="number" widget="badge"/>
                <field name="employee_ids" options="{'no_create': True}" widget="many2many_tags"/>
                <field name="state" widget="badge"/>
                <field name="state_date" widget="date"/>
                <field name="pin" password="0"/>
                <field name="puk" password="0"/>
                <field name="sms_cap_plan"/>
                <field name="calls_cap_plan"/>
                <field name="gprs_cap_plan"/>
                <field name="sms_package"/>
                <field name="plan_rate"/>
                <field name="gprs_package"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_ict_mobile_line_form" model="ir.ui.view">
        <field name="name">ict.mobile.line.form</field>
        <field name="model">ict.mobile.line</field>
        <field name="arch" type="xml">
            <form string="Mobile Line">
                <header>
                    <button name="action_suspend" type="object"
                            class="btn-warning"
                            string="Suspend"
                            invisible="state in ['suspended','cancelled']"/>
                    <button name="action_activate" type="object"
                            class="btn-success"
                            string="Activate"
                            invisible="state != 'suspended'"/>
                    <button name="action_cancel" type="object"
                            class="btn-danger"
                            string="Cancel"
                            confirm="Are you sure you want to cancel this line?"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,assigned,suspended,cancelled"/>
                </header>
                <sheet class="mobile_line_form_sheet">
                    <div class="hero mobile_line_hero">
                        <div class="hero_icon hero_mobile_line">
                            <i class="fa fa-mobile" title="mobile Line"/>
                        </div>
                        <div class="hero_name">
                            <field name="number" placeholder="+53 XXXXXXXX"/>
                        </div>
                        <div class="hero_specs">
                            <span class="hero_spec" title="Start Date">
                                 <i class="fa fa-star"/>
                                <field name="start_date" widget="date"/>
                            </span>
                            <span class="hero_spec" title="End Date">
                                 <i class="fa fa-warning"/>
                                <field name="end_date" widget="date"/>
                            </span>
                            <span class="hero_spec" title="Carrier">
                                <i class="fa fa-signal"/>
                                <field name="carrier"/>
                            </span>
                        </div>
                    </div>

                    <group class="o_ict_mobile_line_details">
                        <group string="Assignment" class="o_ict_group">
                            <field name="state_date" widget="date"/>
                            <field name="job_id" options="{'no_create': True}"/>
                            <field name="mobile_id" options="{'no_create': True}"/>
                            <field name="employee_ids" options="{'no_create': True}" widget="many2many_tags"/>
                        </group>
                        <group string="Security" class="o_ict_group">
                            <field name="imsi"/>
                            <field name="sim_card"/>
                            <field name="pin" password="0"/>
                            <field name="puk" password="0"/>
                        </group>
                    </group>
                    
                    <group class="o_ict_mobile_line_details">
                        <group string="Plan" class="o_ict_group">
                            <field name="sms_cap_plan"/>
                            <field name="calls_cap_plan"/>
                            <field name="gprs_cap_plan"/>
                        </group>
                        <group string="Services" class="o_ict_group">
                            <field name="sms_package"/>
                            <field name="plan_rate"/>
                            <field name="gprs_package"/>
                        </group>
                    </group>           
                    
                    <notebook class="notebook mobile_line_notebook">
                        <page string="Services">
                            <field name="serv" placeholder="Services..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_ict_mobile_line_search" model="ir.ui.view">
        <field name="name">ict.mobile.line.search</field>
        <field name="model">ict.mobile.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="number"/>
                <field name="employee_ids"/>
                <field name="state"/>
                <filter string="Assigned" name="assigned" domain="[('state','=','assigned')]"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="Suspended" name="suspended" domain="[('state','=','suspended')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <group expand="1" string="Group By">
                    <filter string="Status" name="state" domain="[]" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_ict_mobile_line" model="ir.actions.act_window">
        <field name="name">Mobile Lines</field>
        <field name="res_model">ict.mobile.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No Mobile Lines yet. Click here to add a new ICT Mobile Line.
            </p>
        </field>
    </record>

    <!-- ==================== MENU ==================== -->
    <menuitem id="menu_mobile_line" name="Mobile Lines" parent="menu_ict_mobile" sequence="10" action="action_ict_mobile_line"/>

</odoo>