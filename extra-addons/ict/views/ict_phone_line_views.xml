<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View ict.phone.line List -->
    <record id="view_ict_phone_line_list" model="ir.ui.view">
        <field name="name">view.ict.phone.line.list</field>
        <field name="model">ict.phone.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone_number"/>
                <field name="imsi"/>
                <field name="sim_card"/>
                <field name="pin"/>
                <field name="puk"/>
                <field name="secondary_language"/>
                <field name="written_language"/>
                <field name="sms_cap_plan"/>
                <field name="calls_cap_plan"/>
                <field name="roaming_cap_plan"/>
                <field name="gprs_cap_plan"/>
                <field name="sms_package"/>
                <field name="plan_rate"/>
                <field name="gprs_package"/>
                <field name="gprs_profile"/>
            </list>
        </field>
    </record>

    <!-- View ict.phone.line Form -->
    <record id="view_ict_phone_line_form" model="ir.ui.view">
        <field name="name">view.ict.phone.line.form</field>
        <field name="model">ict.phone.line</field>
        <field name="arch" type="xml">
            <form string="Ict Phone Line">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone_number"/>
                            <field name="imsi"/>
                            <field name="sim_card"/>
                            <field name="pin"/>
                            <field name="puk"/>
                            <field name="secondary_language"/>
                            <field name="written_language"/>
                            <field name="sms_cap_plan"/>
                        </group>
                        <group>
                            <field name="calls_cap_plan"/>
                            <field name="roaming_cap_plan"/>
                            <field name="gprs_cap_plan"/>
                            <field name="sms_package"/>
                            <field name="plan_rate"/>
                            <field name="gprs_package"/>
                            <field name="gprs_profile"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View ict.phone.line Search -->
    <record id="view_ict_phone_line_search" model="ir.ui.view">
        <field name="name">view.ict.phone.line.search</field>
        <field name="model">ict.phone.line</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ict.phone.line -->
    <record id="action_ict_phone_line" model="ir.actions.act_window">
        <field name="name">Phone Lines</field>
        <field name="res_model">ict.phone.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new ICT Phone Line.
            </p>
        </field>
    </record>

    <!-- Menu ict.phone.line -->
    <menuitem id="menu_ict_phone_line" name="Lines" parent="menu_ict_phone" sequence="10" action="action_ict_phone_line"/>

</odoo>
