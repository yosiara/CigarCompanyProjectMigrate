<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- 1. Kanban View                                               -->
    <!-- ============================================================ -->
    <record id="view_ict_employee_kanban" model="ir.ui.view">
        <field name="name">ict.employee.kanban</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_employee_ict">
                <field name="name"/>
                <field name="image_1920"/>
                <field name="job_title"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="mobile_phone"/>
                <field name="domain_user"/>
                <field name="department_name"/>
                <field name="department_hex_color"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="user_status"/>
                <field name="computer_ids"/>
                <field name="phone_ids"/>
                <field name="whatsapp_url"/>
                <field name="formatted_hire_date"/>

                <templates>
                    <t t-name="kanban-box">
                        <!-- Tarjeta principal -->
                        <t t-set="dep_color" t-value="record.department_hex_color.raw_value"/>
                        <div class="o_kanban_card_employee"
                             t-attf-style="--dept-color: #{dep_color or '#adb5bd'};">

                            <!-- ===== CABECERA: presencia + departamento ===== -->
                            <t t-set="status" t-value="record.user_status.raw_value"/>
                            <t t-set="dep_name" t-value="record.department_name.raw_value"/>
                            <div class="d-flex gap-5 justify-content-between p-2 pb-0">
                                <span class="presence_dot"
                                      t-att-class="status == 'active' ? 'online' : 'offline'"
                                      t-att-title="status == 'active' ? 'Confirmed' : 'Never Connected'"/>
                                <span t-if="dep_name"
                                      class="badge rounded-pill"
                                      t-attf-style="background-color: #{dep_color or '#aaa'}20; color: #{dep_color or '#555'};">
                                    <t t-out="dep_name"/>
                                </span>
                            </div>

                            <!-- ===== AVATAR + DATOS PRINCIPALES ===== -->
                            <t t-set="job_title" t-value="record.job_title.raw_value"/>
                            <t t-set="hire_date" t-value="record.formatted_hire_date.raw_value"/>
                            <div class="text-center px-3 pt-2">
                                <img t-if="record.image_1920.raw_value"
                                     t-att-src="kanban_image('ict.employee', 'image_1920', record.id.raw_value)"
                                     class="rounded-circle"
                                     loading="lazy"
                                     alt="Employee photo"/>
                                <div t-else="" class="d-flex align-items-center justify-content-center bg-100 bg-gradient rounded-circle mx-auto">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="50" height="50" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                </div>
                                <h5 class="mb-0 employee-name text-truncate">
                                    <t t-out="record.name.raw_value"/>
                                </h5>
                                <small class="text-muted d-block text-truncate" t-if="job_title">
                                    <t t-out="job_title"/>
                                </small>
                                <small class="text-muted" t-if="hire_date">
                                    <i class="fa fa-calendar-o me-1"/> Start: <t t-out="hire_date"/>
                                </small>
                            </div>

                            <!-- ===== DATOS DE CONTACTO ===== -->
                            <t t-set="work_email" t-value="record.work_email.raw_value"/>
                            <t t-set="work_phone" t-value="record.work_phone.raw_value"/>
                            <t t-set="mobile_phone" t-value="record.mobile_phone.raw_value"/>
                            <div class="px-3 pt-3 small contact-info">
                                <div class="d-flex align-items-center contact-line mb-1">
                                    <i class="fa fa-envelope-o me-2" title="Email"/>
                                    <span class="flex-grow-1"><t t-out="work_email"/></span>
                                </div>
                                <div class="d-flex align-items-center contact-line mb-1">
                                    <i class="fa fa-phone me-2" title="Phone Numbers"/>
                                    <span class="phone-numbers">
                                        <t t-if="work_phone">
                                            <span><t t-out="work_phone"/></span>
                                        </t>
                                        <t t-if="work_phone and mobile_phone">
                                            <span class="phone-separator">·</span>
                                        </t>
                                        <t t-if="mobile_phone">
                                            <span><t t-out="mobile_phone"/></span>
                                        </t>
                                    </span>
                                </div>
                            </div>

                            <!-- ===== RESUMEN DE DISPOSITIVOS ===== -->
                            <t t-set="computers" t-value="record.computer_ids.raw_value"/>
                            <t t-set="phones" t-value="record.phone_ids.raw_value"/>
                            <div class="px-3 py-2 small mt-2 devices-summary">
                                <div class="d-flex align-items-center text-muted">
                                    <i class="fa fa-desktop me-1" title="Computer"/> <t t-out="computers.length"/> computers
                                    <span class="device-separator">·</span>
                                    <i class="fa fa-mobile-phone me-1" title="Mobile"/> <t t-out="phones.length"/> mobiles
                                </div>
                            </div>

                            <!-- ===== FOOTER: ACCIONES ADAPTATIVAS ===== -->
                            <t t-set="email" t-value="record.work_email.raw_value"/>
                            <t t-set="user" t-value="record.user_id.raw_value"/>
                            <t t-set="whatsapp" t-value="record.whatsapp_url.raw_value"/>
                            <div class="kanban-footer mt-1 p-1 d-flex justify-content-around align-items-center">
                                <a t-if="email"
                                   type="object"
                                   name="action_send_email"
                                   class="btn btn-sm btn-link footer-action"
                                   role="button"
                                   title="Send email">
                                   <i class="fa fa-envelope-o"/>
                                </a>
                                <widget t-if="user" name="ict_employee_chat"/>
                                <a t-if="record.mobile_phone.raw_value"
                                   t-att-href="record.whatsapp_url.raw_value"
                                   target="_blank"
                                   class="btn btn-sm btn-link footer-action"
                                   onclick="event.stopPropagation();"
                                   role="button"
                                   title="Open WhatsApp">
                                   <i class="fa fa-whatsapp"/>
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 2. List View                                                 -->
    <!-- ============================================================ -->
    <record id="view_ict_employee_list" model="ir.ui.view">
        <field name="name">view.ict.employee.list</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="domain_user" widget="badge"/>
                <field name="work_email" widget="email"/>
                <field name="extension_ids" widget="many2many_tags"/>
                <field name="line_ids" widget="many2many_tags"/>
                <field name="job_title"/>
                <field name="department_name"/>
                <field name="hire_date"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 3. Form View                                                 -->
    <!-- ============================================================ -->
    <record id="view_ict_employee_form" model="ir.ui.view">
        <field name="name">ict.employee.form</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Cabecera -->
                    <div class="o_ict_employee_header">
                        <div class="d-flex align-items-start">
                            <!-- Avatar -->
                            <div class="o_ict_avatar">
                                <field name="image_1920" widget="image" options="{'preview_image': 'image_1920', 'zoom': true}"/>
                            </div>
                            <!-- Información principal -->
                            <div class="o_ict_employee_info">
                                <div class="o_ict_employee_name">
                                    <field name="employee_id" placeholder="Select employee..." options="{'no_create': True}"/>
                                    <field name="user_status" widget="ict_status_badge"/>
                                </div>
                                <div class="o_ict_employee_badges" invisible="not job_title or not department_name">
                                    <span class="o_ict_badge badge-job">
                                        <i class="fa fa-briefcase" title="Job Title"/>
                                        <field name="job_title"/>
                                    </span>
                                    <span class="o_ict_badge badge-department">
                                        <i class="fa fa-building" title="Department"/>
                                        <field name="department_name"/>
                                    </span>
                                </div>
                            </div>
                            <!-- Acciones sociales -->
                            <div class="o_ict_header_actions">
                                <div class="o_ict_social_buttons">
                                    <button class="o_ict_social_btn whatsapp" type="object" name="action_open_whatsapp">
                                        <i class="fa fa-whatsapp"></i>
                                        <span class="tooltip-text">WhatsApp</span>
                                    </button>
                                    <button class="o_ict_social_btn telegram" type="object" name="action_open_telegram">
                                        <i class="fa fa-telegram"></i>
                                        <span class="tooltip-text">Telegram</span>
                                    </button>
                                    <button class="o_ict_social_btn x-twitter" type="object" name="action_open_x">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="white">
                                            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                        </svg>
                                        <span class="tooltip-text">X (Twitter)</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Datos en dos columnas -->
                    <group class="o_ict_employee_details">
                        <group string="Account details" class="o_ict_group">
                            <field name="domain_user" placeholder="Domain user"/>
                            <field name="domain_id" placeholder="Domain"/>
                            <field name="hire_date" placeholder="Hiring date" widget="date"/>
                        </group>
                        <group string="Contacts" class="o_ict_group">
                            <field name="extension_ids" placeholder="Phone Extension" widget="many2many_tags" options="{'no_create': True}" domain="['|', ('department_id', '=', department_id), ('job_id', '=', job_id)]"/>
                            <field name="line_ids" placeholder="Mobile Line" widget="many2many_tags" options="{'no_create': True}" domain="[('job_id', '=', job_id)]"/>
                            <field name="work_email" placeholder="Work Email" widget="email"/>
                        </group>
                    </group>

                    <!-- Do not delete these fields; they are required for domains or for saving using compute or onchange methods. -->
                    <group invisible="1">
                        <field name="department_id"/>
                        <field name="job_id"/>
                    </group>

                    <!-- Equipos asignados -->
                    <group col="3" name="assignments" class="o_ict_employee_equipment">
                        <group string="Assigned computers">
                            <field name="computer_ids" widget="many2many_tags" class="o_ict_equipment_tags" nolabel="1" options="{'no_create': True}"/>
                        </group>
                        <group string="Assigned phones">
                            <field name="phone_ids" widget="many2many_tags" class="o_ict_equipment_tags" nolabel="1" options="{'no_create': True}"/>
                        </group>
                        <group string="Assigned mobiles">
                            <field name="mobile_ids" widget="many2many_tags" class="o_ict_equipment_tags" nolabel="1" options="{'no_create': True}"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 4. Search View                                               -->
    <!-- ============================================================ -->
    <record id="view_ict_employee_search" model="ir.ui.view">
        <field name="name">view.ict.employee.search</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="domain_user"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="mobile_phone"/>
                <field name="job_title"/>
                <field name="department_name"/>
                <field name="hire_date"/>

                <group expand="1" string="Group By">
                    <filter string="Job" name="job_title" domain="[]" context="{'group_by':'job_title'}"/>
                    <filter string="Department" name="department_name" domain="[]" context="{'group_by':'department_name'}"/>
                    <filter string="Hire Date" name="hire_date" domain="[]" context="{'group_by':'hire_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 5. Action                                                    -->
    <!-- ============================================================ -->
    <record id="action_ict_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ict.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples. Click here to add new ICT Employee.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- 6. Menu Item                                                 -->
    <!-- ============================================================ -->
    <menuitem id="menu_employees"
              name="Employees"
              parent="menu_ict_root"
              sequence="10"
              action="ict.action_ict_employee"/>

</odoo>