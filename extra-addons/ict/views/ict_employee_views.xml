<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ict_employee_kanban" model="ir.ui.view">
        <field name="name">ict.employee.kanban</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_employee_ict"> <!-- default_group_by="department_id" -->
                <!-- Campos necesarios para el template -->
                <field name="name"/>
                <field name="job_title"/>
                <field name="hire_date"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="mobile_phone"/>
                <field name="domain_user"/>
                <field name="department_id"/>
                <field name="department_name"/>
                <field name="employee_id"/>
                <field name="user_id"/>  <!-- para presencia y chatter -->
                <field name="computer_ids"/>
                <field name="phone_ids"/>
                <field name="whatsapp_url"/>
                <field name="formatted_hire_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card o_kanban_card_employee"
                            t-attf-style="border-left: 4px solid #{record.department_id.raw_value and record.department_id.raw_value.color or '#e0e0e0'};">

                            <!-- ===== CABECERA: presencia + departamento ===== -->
                            <div class="d-flex justify-content-between p-2 pb-0">
                                <!-- Punto de presencia -->
                                <t t-set="im_status" t-value="record.user_id.raw_value and record.user_id.raw_value.im_status or 'offline'"/>
                                <span class="presence_dot" t-att-class="im_status == 'online' ? 'online' : 'offline'"
                                    t-att-title="im_status == 'online' ? 'Conectado' : 'Desconectado'"/>
                                <!-- Badge de departamento -->
                                <span t-if="record.department_name.raw_value"
                                    class="badge rounded-pill"
                                    t-attf-style="background-color: #{record.department_id.raw_value and record.department_id.raw_value.color or '#aaa'}20; color: {record.department_id.raw_value and record.department_id.raw_value.color or '#555'};">
                                    <t t-esc="record.department_name.raw_value"/>
                                </span>
                            </div>

                            <!-- ===== AVATAR + DATOS PRINCIPALES ===== -->
                            <div class="text-center px-3 pt-2">
                                <t t-set="emp_id" t-value="record.employee_id.raw_value"/>
                                <img t-if="emp_id"
                                    t-att-src="kanban_image('hr.employee', 'image_1920', emp_id)"
                                    class="rounded-circle mb-2"
                                    style="width:100px; height:100px; border: 3px solid white; box-shadow: 0 2px 8px rgba(0,0,0,0.1); object-fit: cover;"/>
                                <h5 class="mb-0 fw-semibold"><t t-esc="record.name.raw_value"/></h5>
                                <small class="text-muted d-block" t-if="record.job_title.raw_value">
                                    <t t-esc="record.job_title.raw_value"/>
                                </small>
                                <!-- <small class="text-muted" t-if="record.hire_date.value">
                                    <i class="fa fa-calendar-o me-1"/> Desde: <t t-esc="record.hire_date.value" t-options='{"format": "MMM yyyy"}'/>
                                </small> -->
                                <small class="text-muted" t-if="record.formatted_hire_date.raw_value">
                                    <i class="fa fa-calendar-o me-1"/> Desde: <t t-esc="record.formatted_hire_date.raw_value"/>
                                </small>
                            </div>

                            <!-- ===== DATOS DE CONTACTO ===== -->
                            <div class="px-3 pt-3 small contact-info">
                                <!-- Email con enlace rápido (opcional) -->
                                <div t-if="record.work_email.raw_value" class="d-flex align-items-center">
                                    <i class="fa fa-envelope-o me-2"/>
                                    <span class="flex-grow-1"><t t-esc="record.work_email.raw_value"/></span>
                                </div>
                                <!-- Teléfonos -->
                                <div t-if="record.work_phone.raw_value or record.mobile_phone.raw_value" class="d-flex align-items-center">
                                    <i class="fa fa-phone me-2"/>
                                    <span>
                                        <t t-esc="record.work_phone.raw_value or ''"/>
                                        <t t-if="record.work_phone.raw_value and record.mobile_phone.raw_value"> · </t>
                                        <t t-esc="record.mobile_phone.raw_value or ''"/>
                                    </span>
                                </div>
                                <!-- Nombre de usuario -->
                                <div t-if="record.domain_user.raw_value" class="d-flex align-items-center">
                                    <i class="fa fa-terminal me-2"/>
                                    <span><t t-esc="record.domain_user.raw_value"/></span>
                                </div>
                            </div>

                            <!-- ===== RESUMEN DE DISPOSITIVOS ===== -->
                            <t t-set="computers" t-value="record.computer_ids.raw_value"/>
                            <t t-set="phones" t-value="record.phone_ids.raw_value"/>
                            <div t-if="computers or phones" class="px-3 py-2 small mt-2 border-top devices-summary">
                                <div class="d-flex align-items-center text-muted">
                                    <t t-if="computers">
                                        <i class="fa fa-desktop me-1"/> <t t-esc="computers.length"/> equipos
                                    </t>
                                    <t t-if="computers and phones" class="mx-2">·</t>
                                    <t t-if="phones">
                                        <i class="fa fa-mobile-phone me-1"/> <t t-esc="phones.length"/> teléfonos
                                    </t>
                                </div>
                            </div>

                            <!-- ===== FOOTER: ACCIONES ADAPTATIVAS ===== -->
                            <div class="kanban-footer border-top mt-2 pt-2 pb-2 px-2 d-flex justify-content-around align-items-center">
                                <!-- Email siempre que haya correo -->
                                <a t-if="record.work_email.raw_value"
                                type="object"
                                name="action_send_email"
                                class="btn btn-sm btn-link footer-action"
                                title="Enviar correo">
                                    <i class="fa fa-envelope-o"/>
                                </a>
                                <!-- Chatter: solo si es usuario del sistema -->
                                <a t-if="record.user_id.raw_value"
                                type="open"
                                class="btn btn-sm btn-link footer-action"
                                title="Abrir chatter">
                                    <i class="fa fa-comments-o"/>
                                </a>
                                <!-- WhatsApp: solo si hay móvil -->
                                <a t-if="record.whatsapp_url.raw_value"
                                t-att-href="record.whatsapp_url.raw_value"
                                target="_blank"
                                class="btn btn-sm btn-link footer-action"
                                title="WhatsApp">
                                    <i class="fa fa-whatsapp"/>
                                </a>
                                <!-- Cuando solo hay un botón, los separadores se añaden con CSS -->
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View ict.employee list -->
    <record id="view_ict_employee_list" model="ir.ui.view">
        <field name="name">view.ict.employee.list</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="domain_user"/>
                <field name="work_email" widget="email"/>
                <field name="work_phone"/>
                <field name="mobile_phone" widget="phone"/>
                <field name="job_title"/>
                <field name="department_name"/>
                <field name="hire_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- View ict.employee form -->
    <record id="view_ict_employee_form" model="ir.ui.view">
        <field name="name">ict.employee.form</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"  placeholder="Pepe Antonio Vargas"/>
                            <field name="domain_user"  placeholder="pepe"/>
                            <field name="domain_id"    placeholder="turei.co.cu"/>
                            <field name="work_phone"   placeholder="222"/>
                            <field name="mobile_phone" placeholder="+53 55555555"/>
                        </group>
                        <group>
                            <field name="job_title"/>
                            <field name="department_name"/>
                            <field name="work_email"/>
                            <field name="hire_date"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <!-- Equipment Assignments -->
                    <group name="assignments">
                        <group string="Assigned Computers">
                            <field name="computer_ids" widget="many2many_tags" row="2"/>
                        </group>
                        <group string="Assigned Phones">
                            <field name="phone_ids" widget="many2many_tags" row="2"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- View ict.employee search -->
    <record id="view_ict_employee_search" model="ir.ui.view">
        <field name="name">view.ict.employee.search</field>
        <field name="model">ict.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="domain_user"/>
                <field name="work_email"/>
                <field name="work_phone"/>
                <field name="mobile_phone"/>
                <field name="job_title"/>
                <field name="department_name"/>
                <field name="hire_date"/>

                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>

                <group expand="1" string="Group By">
                    <filter string="Job" name="job_title" domain="[]" context="{'group_by':'job_title'}"/>
                    <filter string="Department" name="department_name" domain="[]" context="{'group_by':'department_name'}"/>
                    <filter string="Hire Date" name="hire_date" domain="[]" context="{'group_by':'hire_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action ict.employee -->
    <record id="action_ict_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ict.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_active': True}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new ICT Employee.
            </p>
        </field>
    </record>

    <!-- Menu ict.employee -->
    <menuitem id="menu_employees" name="Employees" parent="menu_ict_root" sequence="10" action="ict.action_ict_employee"/>

</odoo>
