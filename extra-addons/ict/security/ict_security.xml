<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="module_category_inventory_ict" model="ir.module.category">
        <field name="name">ICT</field>
        <field name="parent_id" ref="base.module_category_inventory"/>
        <field name="description">Information and Communication Technologies</field>
        <field name="sequence">2</field>
    </record>

    <record id="group_ict_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_inventory_ict"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    
    <record id="group_ict_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_inventory_ict"/>
        <field name="implied_ids" eval="[(4, ref('group_ict_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    
    <data noupdate="1">
        <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('ict.group_ict_user'))]"/>
        </record>
    </data>
</odoo>