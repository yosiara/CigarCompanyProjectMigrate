<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Template principal con header mejorado -->
    <t t-name="ict.ComputerKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <!-- <xpath expr="//div[hasclass('o_kanban_renderer')]" position="attributes">
            <attribute name="t-attf-class">{{ props.list.isGrouped ? 'o_kanban_grouped align-content-stretch' : 'o_kanban_ungrouped align-content-start flex-wrap justify-content-space' }}</attribute>
        </xpath> -->
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <!-- Dashboard Header mejorado -->
            <div class="ict_dashboard_header mb-4">
                <div class="container-fluid px-4">
                    <!-- Filtros rápidos y búsqueda -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="quick-filters">
                                <div class="btn-group" role="group">
                                    <button class="btn btn-filter active" data-filter="all">
                                        <i class="fa fa-th-large me-1"/> Todos
                                    </button>
                                    <button class="btn btn-filter" data-filter="new">
                                        <i class="fa fa-star me-1"/> Nuevos
                                    </button>
                                    <button class="btn btn-filter" data-filter="in_use">
                                        <i class="fa fa-play-circle me-1"/> En Uso
                                    </button>
                                    <button class="btn btn-filter" data-filter="repair">
                                        <i class="fa fa-wrench me-1"/> Reparación
                                    </button>
                                    <button class="btn btn-filter" data-filter="retired">
                                        <i class="fa fa-archive me-1"/> Dados de Baja
                                    </button>
                                </div>
                                <div class="search-box">
                                    <i class="fa fa-search"></i>
                                    <input type="text" class="form-control" placeholder="Buscar equipo..."/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>