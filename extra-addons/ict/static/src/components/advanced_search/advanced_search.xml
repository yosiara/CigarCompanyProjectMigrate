<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ict.AdvancedSearch">
        <div class="o_advanced_search">
            <div class="input-group mb-3">
                <input type="text" 
                       class="form-control" 
                       t-model="state.searchTerm"
                       t-on-input="search"
                       placeholder="Search..."/>
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" 
                            t-on-click="toggleFilters"
                            type="button">
                        <i class="fa fa-filter"/>
                    </button>
                </div>
            </div>
            
            <div t-if="state.showFilters" class="filters mb-3">
                <select t-model="state.filters.department" 
                        class="form-control mb-2"
                        t-on-change="search">
                    <option value="">All Departments</option>
                    <t t-foreach="departments" t-as="dept">
                        <option t-att-value="dept.id" t-out="dept.name"/>
                    </t>
                </select>
                
                <select t-model="state.filters.status" 
                        class="form-control mb-2"
                        t-on-change="search">
                    <option value="">All Status</option>
                    <option value="available">Available</option>
                    <option value="assigned">Assigned</option>
                    <option value="repair">Under Repair</option>
                    <option value="retired">Retired</option>
                </select>
            </div>
            
            <div t-if="state.showResults" class="search-results">
                <t t-foreach="state.results" t-as="result" t-key="result.id">
                    <div class="search-result-item" 
                         t-on-click="() => selectResult(result)">
                        <i t-att-class="'fa ' + getIcon(result)"/>
                        <span t-out="result.display_name"/>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>