<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
		<!-- ======================================================================================
		WAREHOUSE
		Model: stock.warehouse
		=========================================================================================== -->

        <!-- FORM VIEW -->
		<record id="view_warehouse_inherit" model="ir.ui.view">
			<field name="name">stock.warehouse.inherit</field>
			<field name="model">stock.warehouse</field>
			<field name="inherit_id" ref="stock.view_warehouse"/>
			<field name="arch" type="xml">
				<xpath expr="//notebook/page[@name='technical_info']" position="after">
					<page string="Inventory" name="Inventory_info" groups="base.group_no_one">
						<field name="product_control_ids" nolabel="1" readonly="1">
							<tree>
								<field name="product_id"/>
								<field name="quantity"/>
							</tree>
						</field>
					</page>
				</xpath>
			</field>
		</record>

		<!-- ROOT MENU -->
		<menuitem name="Warehouses" id="warehouse_warehouse_root_menu" web_icon="warehouse,static/description/icon.png" sequence="20"/>

        <!-- LEFT MENU -->
        <menuitem name="Warehouses" id="warehouse_warehouse_left_menu" parent="warehouse_warehouse_root_menu"/>

        <!-- MENU ITEM -->
        <menuitem name="Warehouses" id="warehouse_warehouse_menu_item" action="stock.action_warehouse_form" parent="warehouse_warehouse_left_menu"/>
    </data>
</odoo>
