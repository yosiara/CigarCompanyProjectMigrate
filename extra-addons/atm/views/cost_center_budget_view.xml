<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <!-- ======================================================================================
		COST CENTER BUDGET
		Model: atm.cost_center.budget
		=========================================================================================== -->

        <!-- FORM VIEW -->
        <record id="atm_cost_center_budget_form_view" model="ir.ui.view">
            <field name="name">atm_cost_center_budget_form_view</field>
            <field name="model">atm.cost_center.budget</field>
            <field name="arch" type="xml">
            	<form>
            		<sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="cost_center_id"/>
                            </group>

                            <group>
                                <field name="plan"/>
                                <field name="real"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="atm_cost_center_budget_tree_view" model="ir.ui.view">
            <field name="name">atm_cost_center_budget_tree_view</field>
            <field name="model">atm.cost_center.budget</field>
            <field name="arch" type="xml">
            	<tree>
            		<field name="date"/>
            		<field name="cost_center_id"/>
            		<field name="plan"/>
            		<field name="real"/>
	            </tree>
	        </field>
	    </record>

        <!-- ACTION -->
        <record id="atm_cost_center_budget_action" model="ir.actions.act_window">
	    	<field name="name">Budgets</field>
		    <field name="res_model">atm.cost_center.budget</field>
			<field name="binding_view_types">form</field>
			<field name="view_mode">tree,form</field>
		</record>

        <!-- MENU ITEM -->
        <menuitem name="Budgets"
				  id="atm_cost_center_budget_menu_item"
				  action="atm_cost_center_budget_action"
				  parent="atm_general_elements_left_menu"
                  sequence="25"/>
    </data>
</odoo>
