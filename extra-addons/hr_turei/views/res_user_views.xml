<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. Anular sincronización de imagen de usuario → empleado. -->
        <!-- 2. Esta información será sincronizada en sentido inverso: empleado → usuario. -->
        <!-- 3. Si se desea tener una imagen diferente a la del empleado asociado: editar el contacto relacionado del usuario en cuestión. -->
        <!-- 4. Note que si hace lo anterior y luego se edita la imagen desde empleados volverá al segundo punto. -->
        <record id="view_users_form" model="ir.ui.view">
            <field name="name">res.users.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <field name="image_1920" position="attributes">
                    <attribute name="readonly">1</attribute>
                </field>
            </field>
        </record>
    </data>
</odoo>
