<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_company_form_inherit_staffing" model="ir.ui.view">
        <field name="name">res.company.form.inherit.staffing</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="after">
                <group string="Institutional Data">
                    <field name="reup_number"/>
                    <field name="organism"/>
                    <field name="national_entity"/>
                    <field name="staffing_plan_enforced" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>