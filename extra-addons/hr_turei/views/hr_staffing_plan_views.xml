<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- LIST                                                      -->
    <!-- ========================================================= -->
    <record id="view_hr_staffing_plan_list" model="ir.ui.view">
        <field name="name">hr.staffing.plan.list</field>
        <field name="model">hr.staffing.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="department_id"/>
                <field name="total_approved_headcount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_monthly_salary" widget="monetary" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- FORM                                                      -->
    <!-- ========================================================= -->
    <record id="view_hr_staffing_plan_form" model="ir.ui.view">
        <field name="name">hr.staffing.plan.form</field>
        <field name="model">hr.staffing.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('cancelled', 'approved')"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Reset to Draft"
                            invisible="state in ('draft',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_approved_headcount"/>
                            <field name="total_monthly_salary" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                    <field name="scale_group"/>
                                    <field name="occupational_category"/>
                                    <field name="preparation_level"/>
                                    <field name="approved_headcount"/>
                                    <field name="current_headcount" optional="hide"/>
                                    <field name="vacant_headcount" optional="hide"/>
                                    <field name="plan_state" column_invisible="1"/>
                                    <field name="salary" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                    <button name="action_open_recruitment" type="object"
                                            string="Open Recruitment"
                                            class="btn-link"
                                            icon="fa-users"
                                            invisible="plan_state != 'approved' or not vacant_headcount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- SEARCH                                                    -->
    <!-- ========================================================= -->
    <record id="view_hr_staffing_plan_search" model="ir.ui.view">
        <field name="name">hr.staffing.plan.search</field>
        <field name="model">hr.staffing.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="department_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_my_plans" string="My Plans"
                        domain="[('create_uid', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- ACTION + MENU                                             -->
    <!-- ========================================================= -->
    <record id="action_hr_staffing_plan" model="ir.actions.act_window">
        <field name="name">Staffing Plans</field>
        <field name="res_model">hr.staffing.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_department': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first staffing plan
            </p>
            <p>
                Define the approved headcount and salaries per department for a given period.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_staffing_plan"
              name="Staffing Plans"
              parent="hr.menu_config_recruitment"
              action="action_hr_staffing_plan"
              groups="hr.group_hr_user"
              sequence="3"/>

</odoo>