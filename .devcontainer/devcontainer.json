{
    "name": "Odoo Dev",
    "dockerComposeFile": [
        "../compose.dev.yml",
        "docker-compose.yml"
    ],
    "service": "odoo",
    "remoteUser": "${localEnv:USER:-developer}",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "shutdownAction": "stopCompose",
    // "overrideCommand": false,
    // "mounts": [
    //     // 1. Configuraciones personales
    //     "source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind,readonly",
    //     "source=${localEnv:HOME}/.gitconfig,target=${localEnv:HOME}/.gitconfig,type=bind,readonly"
    //     "source=${localEnv:HOME}/.zshrc,target=/home/vscode/.zshrc,type=bind,readonly",
    //     "source=${localEnv:HOME}/.oh-my-zsh,target=/home/vscode/.oh-my-zsh,type=bind"
    // ]
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-pylance",
                "redhat.vscode-xml",
                "mechatroner.rainbow-csv",
                "eamodio.gitlens",
                "GitHub.copilot"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.analysis.stubPath": "odoo-stubs-18.0",
                "python.analysis.extraPaths": [
                    "/usr/bin/odoo"
                ],
                "python.autoComplete.extraPaths": [
                    "/usr/lib/python3/dist-packages/odoo/addons",
                    "enterprise-addons",
                    "extra-addons"
                ],
                // "python.analysis.typeCheckingMode": "basic",
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pyc": true,
                    "**/.po": true,
                    "**/.pot": true
                },
                "remote.autoForwardPorts": false
            }
        }
    },
    "postCreateCommand": "nohup sleep infinity >/dev/null 2>&1 & echo $! > /tmp/odoo_keepalive.pid && echo \"Keep-alive started with PID: $(cat /tmp/odoo_keepalive.pid)\"",
    "postStartCommand": "test -e community-addons || ln -s /usr/lib/python3/dist-packages/odoo/addons ./community-addons"
    // "terminal.integrated.shell.linux": "/bin/bash",
    // // "postCreateCommand": "ln -sf /usr/lib/python3/dist-packages/odoo/addons .",
    // "postAttachCommand": {
    //     "server": "bash /debug-entrypoint.sh"
    // }
    // "forwardPorts": [8069, 5678]
    // "features": {
    //     "git": "latest"
    // }
}