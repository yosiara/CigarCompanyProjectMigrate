{
    "name": "Odoo Dev",
    "dockerComposeFile": [
        "../compose.dev.yml",
        "docker-compose.yml"
    ],
    "service": "odoo",
    "remoteUser": "${localEnv:USER:-developer}",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "shutdownAction": "stopCompose",
    // "overrideCommand": false,
    // "mounts": [
    //     // 1. Configuraciones personales
    //     "source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind,readonly",
    //     "source=${localEnv:HOME}/.gitconfig,target=${localEnv:HOME}/.gitconfig,type=bind,readonly"
    //     "source=${localEnv:HOME}/.zshrc,target=/home/vscode/.zshrc,type=bind,readonly",
    //     "source=${localEnv:HOME}/.oh-my-zsh,target=/home/vscode/.oh-my-zsh,type=bind"
    // ]
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-pylance",
                "trinhanhngoc.vscode-odoo",
                "mstuttgart.odoo-snippets",
                "mvintg.odoo-file",
                "redhat.vscode-xml",
                "mechatroner.rainbow-csv",
                "GitHub.copilot",
                "jeffery9.odoo-snippets"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.analysis.stubPath": "/workspaces/${localWorkspaceFolderBasename}/odoo-stubs",
                "python.analysis.extraPaths": [
                    "/usr/lib/python3/dist-packages/odoo",
                    "/workspaces/${localWorkspaceFolderBasename}/extra-addons",
                    "/workspaces/${localWorkspaceFolderBasename}/enterprise-addons"
                ],
                "python.languageServer": "None",
                "remote.autoForwardPorts": false,
                "remote.downloadExtensionsLocally": true,
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pyc": true,
                    "**/.po": true,
                    "**/.pot": true
                }
            }
        }
    },
    "postCreateCommand": "test -e community-addons || ln -s /usr/lib/python3/dist-packages/odoo/addons community-addons"
}