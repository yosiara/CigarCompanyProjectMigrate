{
    "name": "Odoo Dev",
    "dockerComposeFile": [
        "../compose.opermix.yml",
        "docker-compose.yml"
    ],
    "service": "odoo",
    "remoteUser": "${localEnv:USER:-developer}",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "shutdownAction": "stopCompose",
    // "overrideCommand": false,
    // "mounts": [
    //     // 1. Configuraciones personales
    //     "source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind,readonly",
    //     "source=${localEnv:HOME}/.gitconfig,target=${localEnv:HOME}/.gitconfig,type=bind,readonly"
    //     "source=${localEnv:HOME}/.zshrc,target=/home/vscode/.zshrc,type=bind,readonly",
    //     "source=${localEnv:HOME}/.oh-my-zsh,target=/home/vscode/.oh-my-zsh,type=bind"
    // ]
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.vscode-pylance",
                "redhat.vscode-xml",
                "mechatroner.rainbow-csv",
                "eamodio.gitlens",
                "GitHub.copilot"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.analysis.stubPath": "odoo-stubs-18.0",
                // "python.analysis.extraPaths": [
                //     "extra-addons",
                //     "/usr/lib/python3/dist-packages/odoo",
                //     "/usr/lib/python3/dist-packages/odoo/addons"
                // ],
                // "python.analysis.typeCheckingMode": "basic",
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pyc": true
                },
                "editor.formatOnSave": true
            }
        }
    }
    // "postCreateCommand": "ln -sf /usr/lib/python3/dist-packages/odoo/addons ."
    // "postCreateCommand": [
    //     // ... zsh ...
    //     "sudo apt-get update && sudo apt-get install -y zsh",
